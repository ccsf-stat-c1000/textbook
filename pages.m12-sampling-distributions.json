Term","template":"{name}","resolved":true,"html_id":"term-sample","remote":true,"url":"/pages/glossary","dataUrl":"/pages.glossary.json","key":"G4qH8e2BX0"},{"type":"text","value":" and its values for the entire ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"OZ2jQb0KXJ"},{"type":"crossReference","label":"population","identifier":"term-population","children":[{"type":"text","value":"population","key":"OnI0HdjHI9"}],"kind":"definitionTerm","template":"{name}","resolved":true,"html_id":"term-population","remote":true,"url":"/pages/glossary","dataUrl":"/pages.glossary.json","key":"Ii1RUgGllP"},{"type":"text","value":" from which the sample was taken. This module is the bridge between probability and our ultimate goal of the course, statistical inference. In inference, we look at a sample and ask what we can say about the population from which it was drawn. In this module, we’ll pose the reverse question: If I know what the population looks like, what can I expect the sample to look like? Clearly, inference poses the more practical question, since in practice we can look at a sample, but rarely do we know what the whole population looks like. This module will be more theoretical in nature, since it poses a problem which is not really practical, but will present important ideas which are the underpinnings for statistical inference.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"XFySstNMJs"}],"key":"XG3sAHWTln"}],"key":"yMPcMOGd9O"}],"key":"RbuZhqSNOH"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Wrap-Up: Random Variables","url":"/pages/m11-wrap-up-random-variables","group":"Section 8: Random Variables"},"next":{"title":"Parameters vs. Statistics","url":"/pages/m12-parameters-vs-statistics","group":"Section 9: Sampling Distributions"}}},"domain":"http://localhost:3000"}