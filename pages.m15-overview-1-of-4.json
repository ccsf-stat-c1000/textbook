e":34,"column":1},"end":{"line":34,"column":1}},"key":"krF2NB4qCx"},{"type":"emphasis","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Comment:","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"BMeokpa7A9"}],"key":"RsuQfuP8yQ"},{"type":"text","value":" as you’ll see in the examples that follow, these claims are usually about the value of population parameter(s) or about the existence or nonexistence of a relationship between two variables in the population.)","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"i2az2zxdg1"}],"key":"R498dKB29k"}],"key":"L9IylXeHii"},{"type":"listItem","spread":true,"position":{"start":{"line":36,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"We choose a sample, collect relevant data and summarize them (this is similar to the instructor collecting evidence from the student’s exam).","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"zcfQDTnKHO"}],"key":"tIGe1FN5BK"}],"key":"vNRpqtaygz"},{"type":"listItem","spread":true,"position":{"start":{"line":38,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"We figure out how likely it is to observe data like the data we got, had claim 1 been true. (Note that the wording “how likely ...” implies that this step requires some kind of probability calculation.) In the story, the committee members assessed how likely it is to observe evidence like that which the instructor provided, had the student’s claim of not cheating been true.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"JCTqxm3xls"}],"key":"oGm3T8EGh6"}],"key":"lLkEbyBUtN"},{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Based on what we found in the previous step, we make our decision:","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"LJQttfqlYE"}],"key":"CsQHhsPJ6h"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":42,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"If we find that if claim 1 were true it would be extremely unlikely to observe the data that we observed, then we have strong evidence against claim 1, and we reject it in favor of claim 2.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"PiNreXQUY9"}],"key":"BwiOMDriCk"}],"key":"TAamBKs53y"},{"type":"listItem","spread":true,"position":{"start":{"line":43,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"If we find that if claim 1 were true observing the data that we observed is not very unlikely, then we do not have enough evidence against claim 1, and therefore we cannot reject it in favor of claim 2.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"vrNlgyzVAR"}],"key":"s0HIUxRiRm"}],"key":"bKdYUrEWOc"}],"key":"GFL1ffj6LU"}],"key":"E5iqGaE0b2"}],"key":"UAljbJ3c2I"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"In our story, the committee decided that it would be extremely unlikely to find the evidence that the instructor provided had the student’s claim of not cheating been true. In other words, the members felt that it is extremely unlikely that it is just a coincidence that the student used the numbers from the other version of the exam on three separate problems. The committee members therefore decided to reject the student’s claim and concluded that the student had, indeed, cheated on the exam. (Wouldn’t you conclude the same?)","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"ti3RbhuuBS"}],"key":"BkWBKf6G04"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Hopefully this example helped you understand the logic behind hypothesis testing. To strengthen your understanding of the process of hypothesis testing and the logic behind it, let’s look at a statistical example.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"cJrpub8w1z"}],"key":"RxKn9m1ZfO"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: Smoking at Goodheart University","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"hDYN9iaC21"}],"key":"ntiDVM9mX0"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"A recent study estimated that 20% of all college students in the United States smoke. The head of Health Services at Goodheart University suspects that the proportion of smokers may be lower there. In hopes of confirming her claim, the head of Health Services chooses a random sample of 400 Goodheart students, and finds that 70 of them are smokers.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"oWC8vlT3fG"}],"key":"rpdDmjQiss"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"Let’s analyze this example using the 4 steps outlined above:","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"vqhNSrEwPB"}],"key":"ShVopmSZdw"},{"ty