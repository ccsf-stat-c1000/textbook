","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"MSq0HZhj5n"}],"key":"WhP5YAOxNq"},{"type":"text","value":" in this case:","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"aHzyodQjGb"}],"key":"tnPqnJURX8"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":16,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"hVe1NlWX1O"},{"type":"emphasis","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"student’s claim:","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"GnLL19OkeO"}],"key":"t0gxHhCXLd"},{"type":"text","value":" I did not cheat on the exam.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"D3xg8CrFmS"}],"key":"B0rZCUUofp"}],"key":"v7xE9apsFQ"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"lpxDcHtHSU"},{"type":"emphasis","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"instructor’s claim:","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"GYz5iDwOZH"}],"key":"G8VVCgGMcG"},{"type":"text","value":" The student did cheat on the exam.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"oGBuJsdcOw"}],"key":"JulJUNrsvb"}],"key":"ilxvqNVCfc"}],"key":"T53PcQeTs9"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","va