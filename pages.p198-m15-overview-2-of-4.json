YIioKWjX"}],"key":"ZegBTzWEeG"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":38,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"paragraph","children":[{"type":"emphasis","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Claim 1:","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"kvENm5lrul"}],"key":"E2DOQbpwbd"},{"type":"text","value":" Performance on the SAT is not related to gender (males and females score the same).","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"uOrwGasIoK"}],"key":"BndYgmdHKI"}],"key":"bIbqUnaltA"},{"type":"listItem","spread":true,"position":{"start":{"line":39,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"paragraph","children":[{"type":"emphasis","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Claim 2:","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"YpipXTiXP2"}],"key":"Hf2h37Xx0v"},{"type":"text","value":" Performance on the SAT is related to gender—males score higher.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"OBeWsKA1oA"}],"key":"U49w6XnXFU"}],"key":"QBDzP9UZAv"}],"key":"uPgRmbE9KH"}],"key":"hm80hIZqnh"},{"type":"listItem","spread":true,"position":{"start":{"line":41,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Choosing a sample and collecting data:","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"HGFgwOvjQZ"}],"key":"LKfrV0Q3uF"},{"type":"text","value":" Data were collected and summarized as given above. Is the fact that the sample mean score of males (1,025) is higher than the sample mean score of females (1,010) by 15 points strong enough information to reject claim 1 and conclude that in this researcher’s school district, males score higher on the SAT than females?","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"VXr5NtGiPN"}],"key":"rum1HLB2R5"}],"key":"SoPPL7NRG9"},{"type":"listItem","spread":true,"position":{"start":{"line":43,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Assessment of evidence:","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"YoQNv7Z8b1"}],"key":"RvM6nubVy1"},{"type":"text","value":" In order to assess whether the data provide strong enough evidence against claim 1, we need to ask ourselves: If SAT scores are in fact not related to gender (claim 1 is true), how likely is it to get data like the data we observed, in which the difference between the males’ average and females’ average score is as high as 15 points or higher? It turns out that the probability of observing such a sample result if SAT score is not related to gender is approximately 0.29. (Again, do not worry about how this was calculated at this point.)","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"YdEhnbWoGM"}],"key":"jHQBNQg7AU"}],"key":"srg6yj3wls"},{"type":"listItem","spread":true,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Conclusion:","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"w2bFDN6fM5"}],"key":"LIwm5bwkes"},{"type":"text","value":" Here, we have an example where observing a sample like the one we observed is definitely not surprising (roughly 30% chance) if claim 1 were true (i.e., if indeed there is no difference in SAT scores between males and females). We therefore conclude that our data do not provide enough evidence for rejecting claim 1.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"Wmf59e7RBs"}],"key":"Bt8ET6ypRF"}],"key":"ncv7lFJdee"}],"key":"dVkIYJpzRy"}],"class":"tip","key":"PcDqK6LzZr"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Comment","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"dRbgIXD9CS"}],"key":"xG2F5liaRX"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Go back and read the conclusion sections of the three examples, and pay attention to the wording. Note that there are two types of conclusions:","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"v5SoPAswoH"}],"key":"aoep1KOTfD"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":53,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"“The data provide enough evidence to reject claim 1 and accept claim 2”; or","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"MItLeabe9B"}],"key":"eOjpr6dDP4"}],"key":"P8BtQMZ18c"},{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"“The data do not provide enough evidence to reject claim 1.”","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"T0c6swfPBR"}],"key":"idwZ7DDydJ"}],"key":"SdXR57LyO0"}],"key":"lJQVGZa1Rs"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"In particular, note that in the second type of conclusion ","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"oTHnQnz8an"},{"type":"emphasis","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"we did not say:","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"ZMHYkJy5mt"}],"key":"kwWC6q4Iv4"},{"type":"text","value":" “","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"KzcrX1HW9L"},{"type":"emphasis","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"I accept claim 1","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"fB34DfFDn1"}],"key":"LOVCdsIDWB"},{"type":"text","value":",” but only “","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"HQVelDmRHT"},{"type":"emphasis","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"I don’t have enough evidence to reject claim 1","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"b5ng6HIuTV"}],"key":"L3pNbI8QY1"},{"type":"text","value":".” We will come back to this issue later, but this is a good place to make you aware of this subtle difference.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"GuuiCaXYFJ"}],"key":"NaJ7K22CbZ"},{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Hopefully by now, you understand the logic behind the statistical hypothesis testing process. Here is a summary:","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"eSat5QaiK9"}],"key":"RS4SarnCS0"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/textbook/build/m15-logic-flow-097a87528ac5381239f5818ca6cd700c.svg","alt":"A flow chart describing the process. First, we state Claim 1 and Claim 2. Claim 1 says \"nothing special is going on\" and is challenged by Claim 2. Second, we collect relevant data and summarize them. Third, we assess how surprising it would be to observe data like that observed if Claim 1 were true. Fourth, we draw conclusions in context.","key":"WKMWtH43Bc","urlSource":"images/gen/m15-logic-flow.svg"}],"enumerator":"1","key":"BlijikZffl"}],"class":"important","key":"G3UNzv3Odt"},{"type":"heading","depth":2,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"Check Your Understanding: Assessing the Evidence","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"flm0MszcNV"}],"identifier":"check-your-understanding-assessing-the-evidence","label":"Check Your Understanding: Assessing the Evidence","html_id":"check-your-understanding-assessing-the-evidence","implicit":true,"key":"tVeP84eR5q"},{"type":"paragraph","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"For many years “working full-time” has meant 40 hours per week. Nowadays it seems that corporate employers expect their employees to work more than this amount. A researcher decides to investigate this hypothesis.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"bOT0sYM9HY"}],"key":"Tj6p6u0sbG"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":69,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"paragraph","children":[{"type":"emphasis","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"Claim 1:","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"tmn10gYlm7"}],"key":"RMtemeGhsf"},{"type":"text","value":" The average time full-time corporate employees work per week is 40 hours.","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"xCSkcYWx0i"}],"key":"drpvQaqzgD"}],"key":"dWMU0jaPFD"},{"type":"listItem","spread":true,"position":{"start":{"line":70,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"paragraph","children":[{"type":"emphasis","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Claim 2:","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"jlt6m7S0T1"}],"key":"dTvLXyiWxK"},{"type":"text","value":" The average time full-time corporate employees work per week is more than 40 hours.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"vJn5zNhVnN"}],"key":"CjpWADj5c7"}],"key":"qhxi7xxneP"}],"key":"t0g1sNIZxB"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"To substantiate his claim, the researcher randomly selects 250 corporate employees and finds that they work an average of 47 hours per week with a standard deviation of 3.2 hours.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"bF7iluaGm5"}],"key":"SWtTLN28Zu"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-25d2578daaee263925d723f08bb887bd.mjs","model":{"question":"In step 3 of the hypothesis test, which question must the researcher answer in order to assess the evidence?","choices":[{"correct":true,"text":"How likely is a sample average of 47 hours or more, assuming the population average is really 40 hours?","feedback":"Correct! We assess how likely a sample mean of 47 hours or more would be in a sample of 250 employees if the population average were really 40 hours."},{"correct":false,"text":"How likely is it that the population average is 40 hours, given that the sample average was 47?","feedback":"This gets it backward—we assume claim 1 is true and ask how surprising the data are, not the other way around."},{"correct":false,"text":"What is the probability that claim 1 is true?","feedback":"The probability that claim 1 is true is not what the assessment step (or the p-value) measures."}],"multi":false,"hint":"Step 3 always asks how surprising the observed data would be IF claim 1 were true.","explanation":""},"key":"d3Nel27D9Y"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"According to the Centers for Disease Control and Prevention (CDC), roughly 21.5% of all high-school seniors in the United States have used marijuana. (","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"MQB2PFOYkv"},{"type":"emphasis","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Comment:","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"vSpGHNFV4e"}],"key":"mzRyhMOo23"},{"type":"text","value":" the figure represents those who reported use during the month prior to the survey, so the actual figure might be higher.) A sociologist suspects that the rate among African-American high school seniors is lower, and wants to check that. In this case, then,","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"GpBluJONCA"}],"key":"y1GtZhLd7X"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":86,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"paragraph","children":[{"type":"emphasis","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"Claim 1:","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"lHQu7NBw8d"}],"key":"GDRySuCxsy"},{"type":"text","value":" The rate of African-American high-school seniors who have used marijuana is 21.5% (same as the overall rate of seniors).","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"Y7kvRh4y4z"}],"key":"S4GUkxJiaM"}],"key":"TdSVLOru9a"},{"type":"listItem","spread":true,"position":{"start":{"line":87,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"paragraph","children":[{"type":"emphasis","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"Claim 2:","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"gfZl81xKLX"}],"key":"icmMtHa10d"},{"type":"text","value":" The rate of African-American high-school seniors who have used marijuana is lower than 21.5%.","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"A8lA4PISW9"}],"key":"rGrdeBDnj6"}],"key":"at201jVRlz"}],"key":"U9B7SbEhXf"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"To check his claim, the sociologist chooses a random sample of 375 African-American high school seniors, and finds that 16.5% of them have used marijuana.","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"iTPLy8wUH1"}],"key":"I2fqqVHvfX"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-25d2578daaee263925d723f08bb887bd.mjs","model":{"question":"Which probability would provide the appropriate assessment of the evidence in this study?","choices":[{"correct":true,"text":"The probability of a sample proportion of 16.5% or lower, if the true rate were 21.5%","feedback":"Correct! We ask how likely a sample proportion as low as 16.5% (or lower) would be in a random sample of 375 if the true rate were 21.5%."},{"correct":false,"text":"The probability of a sample proportion of 16.5% or lower, if the true rate were lower than 21.5%","feedback":"We must condition on claim 1 being true—not on claim 2."},{"correct":false,"text":"The probability of getting a sample proportion of exactly 16.5%","feedback":"We need the probability of results as extreme as (or more extreme than) the observed one, not of exactly 16.5%."}],"multi":false,"hint":"The evidence is a sample proportion of 16.5%. Claim 2 says the rate is LOWER, so results as low as, or lower than, the observed one count against claim 1.","explanation":""},"key":"h3u1F7OLKi"},{"type":"heading","depth":2,"position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"Check Your Understanding: Evidence and the Alternative","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"k6UpySQjVs"}],"identifier":"check-your-understanding-evidence-and-the-alternative","label":"Check Your Understanding: Evidence and the Alternative","html_id":"check-your-understanding-evidence-and-the-alternative","implicit":true,"key":"xXVLDf691K"},{"type":"paragraph","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"The most commonly accepted tradition is that college students will study 2 hours outside of class for every hour in class. This means 30 hours/week for a full-time student taking 15 units (hours of class). An educator suspects that this figure is different now than in the past.","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"pyoOE2vIuV"}],"key":"IwjVTrmWwy"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":105,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"paragraph","children":[{"type":"emphasis","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"text","value":"Claim 1:","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"aXJUtJdGML"}],"key":"GAKLqUEQnX"},{"type":"text","value":" The average time full-time college students study outside of class per week is 30 hours.","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"KS8MlMbwWK"}],"key":"VMqbBfDJuF"}],"key":"sjlHOE0XEs"},{"type":"listItem","spread":true,"position":{"start":{"line":106,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"paragraph","children":[{"type":"emphasis","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"Claim 2:","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"rEzPttYC8y"}],"key":"xEGA1aGRty"},{"type":"text","value":" The average time full-time college students study outside of class per week is not 30 hours.","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"h3nLNZVOjr"}],"key":"O47nvGJcky"}],"key":"AVf31he4Wu"}],"key":"ywuMqCDxSk"},{"type":"paragraph","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"To substantiate her claim, the educator randomly selects 1,500 college students and finds that they study an average of 27 hours per week with a standard deviation of 1.7 hours.","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"gPD835LfsN"}],"key":"WKO5pcRgjT"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-25d2578daaee263925d723f08bb887bd.mjs","model":{"question":"Notice that claim 2 here says the average is \"not 30 hours\" (rather than specifically more or less). Which sample results would count as evidence against claim 1?","choices":[{"correct":true,"text":"Sample averages much lower OR much higher than 30","feedback":"Correct! Since claim 2 is two-sided, sample averages far from 30 in EITHER direction (like the observed 27) count against claim 1."},{"correct":false,"text":"Only sample averages much lower than 30","feedback":"That would be appropriate if claim 2 said the average is LESS than 30, but it says \"not 30.\""},{"correct":false,"text":"Sample averages close to 30","feedback":"Sample averages near 30 support claim 1; they are not evidence against it."}],"multi":false,"hint":"Compare this claim 2 with the one-directional claims in the previous two studies.","explanation":""},"key":"Nshhn0AeOz"}],"key":"vbREupXfcM"}],"key":"GgN5FeIJuM"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"The Logic of Hypothesis Testing","url":"/pages/p197-m15-overview-1-of-4","group":"Section 12: Hypothesis Testing"},"next":{"title":"Null and Alternative Hypotheses","url":"/pages/p199-m15-overview-3-of-4","group":"Section 12: Hypothesis Testing"}}},"domain":"http://localhost:3000"}