e":"emphasis","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"above","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"uZRxdW3dx3"}],"key":"uzuHxgoVCD"},{"type":"text","value":" has z = +1.28. We seek the foot length that is 1.28 standard deviations above its mean: 11 + 1.28(1.5) = 12.92, or just under 13 inches.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"VPkxkZz3uJ"}],"key":"DYUZ2WA54u"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Method 2:","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"dzXhw4UgGG"}],"key":"UyexYlbV2W"},{"type":"text","value":" If the probability is 0.10 that a foot will be longer than the value we seek, then the probability is 0.90 that a foot will be shorter than that same value, since the probabilities must sum to 1. According to the table, a probability of 0.90 below is associated with a z value of +1.28. Again, we seek the foot length that is 1.28 standard deviations above its mean, or 12.92 inches.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"b4ijAC8iOI"}],"key":"zy7VD8bTvS"}],"key":"jqrWIBD0BI"}],"key":"ETFbZz6PYV"}],"class":"tip","key":"wD3JSlSvhE"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Comment","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"EhvKJMJHvw"}],"key":"hgtHa30oqU"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Part 1 of the above example","position":{"start":{"line":37,"column":