{"version":3,"kind":"Article","sha256":"1fed0436622836f445ae65746908f84aeba64ccff5bd0c7593d8e4f64fc7d438","slug":"index","location":"/pages/intro.md","dependencies":[],"frontmatter":{"title":"Introduction to Statistics","content_includes_title":false,"authors":[{"nameParsed":{"literal":"City College of San Francisco","given":"City College","non_dropping_particle":"of","family":"San Francisco"},"name":"City College of San Francisco","id":"contributors-myst-generated-uid-0"}],"license":{"content":{"id":"CC-BY-NC-SA-4.0","url":"https://creativecommons.org/licenses/by-nc-sa/4.0/","name":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","CC":true}},"abbreviations":{"ANOVA":"Analysis of Variance","CI":"Confidence Interval","CLT":"Central Limit Theorem","EDA":"Exploratory Data Analysis","IQR":"Interquartile Range","SD":"Standard Deviation","SE":"Standard Error","SRS":"Simple Random Sample","INCREASE":null,"INCREASED":null,"DECREASES":null,"OBSERVED":null,"ROSE":null},"thumbnail":"/textbook/build/8c35bb4943e8d7ec21a2c6c8d18dec73.png","exports":[{"format":"md","filename":"intro.md","url":"/textbook/build/intro-9174a255d1e6231d2e63a1b4cca8cdbe.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"About This Book","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zGnVO9uKFq"}],"identifier":"about-this-book","label":"About This Book","html_id":"about-this-book","implicit":true,"key":"UCVf6HI8bn"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This book introduces you to the core ideas of probability and statistics, the tools researchers, scientists, and analysts use to make sense of data and draw conclusions from it. No prior statistics knowledge is needed, just comfort with intermediate algebra.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"OhdHDpFlb8"}],"key":"s2WXCePPLN"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"You’ll start by learning how to gather, describe, and visualize data, then build up a theoretical foundation in probability and, finally, explore the concept of statistical inference, the process of using sample data to answer questions about the wider world. Along the way, you’ll see how these methods apply across fields from medicine to economics to everyday decision-making.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"EY1gsxa8if"}],"key":"Sej6hxda33"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"About This Course","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Eu515RGvcE"}],"identifier":"about-this-course","label":"About This Course","html_id":"about-this-course","implicit":true,"key":"cq3rFRqpwm"},{"type":"heading","depth":3,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Course Description","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"tRiLAmRyk9"}],"identifier":"course-description","label":"Course Description","html_id":"course-description","implicit":true,"key":"MeCiwvO2uO"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"This course is an introduction to statistical thinking and processes, including methods and concepts for discovery and decision-making using data. Topics include descriptive statistics; probability and sampling distributions; statistical inference; correlation and linear regression; analysis of variance, chi-squared, and t-tests; and application of technology for statistical analysis, including the interpretation of the relevance of the statistical findings. Students apply methods and processes to applications using data from a broad range of disciplines.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"zdtVOaYYQp"}],"key":"JRwBeaMITj"},{"type":"heading","depth":3,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Student Learning Outcomes","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"s9U76iTacJ"}],"identifier":"student-learning-outcomes","label":"Student Learning Outcomes","html_id":"student-learning-outcomes","implicit":true,"key":"LuRYjfpyKs"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Upon completion of this course, a student will be able to:","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"VuQSQ7l3dV"}],"key":"P4PZVZlRK8"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":16,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Assess how data were collected and recognize how data collection affects what conclusions can be drawn from the data.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"i3GQOcuaPj"}],"key":"TWGyle0QvS"}],"key":"CVuGWOavKB"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Identify appropriate graphs and summary statistics for variables and relationships between them and correctly interpret information from graphs and summary statistics.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"qE2YwL1SEq"}],"key":"yvbBsUeCgK"}],"key":"QCnChtykav"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Describe and apply probability concepts and distributions.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"NftcVz5KPP"}],"key":"uT32fADUOu"}],"key":"qlgs1VhZy1"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Demonstrate an understanding of, and ability to use, basic ideas of statistical processes, including hypothesis tests and confidence interval estimation.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"DZQHaZ82wq"}],"key":"O5GzamoEZ5"}],"key":"FoESvLiyYN"},{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Identify appropriate statistical techniques and use technology-based statistical analysis to describe, interpret, and communicate results.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"rMRaPciHUR"}],"key":"jgfq3A7bsx"}],"key":"Zy6VAxIR4c"},{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Evaluate ethical issues in statistical practice.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"ccBerNA6tq"}],"key":"krcWutie1V"}],"key":"BNoNbNS6Bi"}],"key":"sX3MTZbNP6"},{"type":"heading","depth":2,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Attribution","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"aUZevicqB6"}],"identifier":"attribution","label":"Attribution","htm