{"version":3,"kind":"Article","sha256":"44b7aa70a78c3ceebdb4ffcdec0283bf95a2aab35a579cdbf2f2d1e6de3b86c5","slug":"index","location":"/pages/intro.md","dependencies":[],"frontmatter":{"title":"STAT C1000: Introduction to Statistics","content_includes_title":false,"authors":[{"nameParsed":{"literal":"City College of San Francisco","given":"City College","non_dropping_particle":"of","family":"San Francisco"},"name":"City College of San Francisco","id":"contributors-myst-generated-uid-0"}],"license":{"content":{"id":"CC-BY-NC-SA-4.0","url":"https://creativecommons.org/licenses/by-nc-sa/4.0/","name":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","CC":true}},"thumbnail":"/textbook/build/8c35bb4943e8d7ec21a2c6c8d18dec73.png","exports":[{"format":"md","filename":"intro.md","url":"/textbook/build/intro-853432120d482da5f08eb012e63ba950.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"About This Book","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"o2J6nPm74s"}],"identifier":"about-this-book","label":"About This Book","html_id":"about-this-book","implicit":true,"key":"ZH9CniBhJi"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"This book introduces you to the core ideas of probability and statistics,\nthe tools researchers, scientists, and analysts use to make sense of data and\ndraw conclusions from it. No prior statistics knowledge is needed, just comfort\nwith intermediate algebra.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"EqVYhzEJPL"}],"key":"b212iQcvZH"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"You’ll start by learning how to gather, describe, and visualize data, then build\nup a theoretical foundation in probability and, finally, explore the concept of\nstatistical inference, the process of using sample data to answer questions about\nthe wider world. Along the way, you’ll see how these methods apply across fields\nfrom medicine to economics to everyday decision-making.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"Z4fPOedhml"}],"key":"hEurlvWNdK"},{"type":"heading","depth":2,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"About This Course","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"wzJfnrexBi"}],"identifier":"about-this-course","label":"About This Course","html_id":"about-this-course","implicit":true,"key":"Mnsqfr5r4a"},{"type":"heading","depth":3,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Course Description","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"ve7meioleP"}],"identifier":"course-description","label":"Course Description","html_id":"course-description","implicit":true,"key":"mqdkWG0GsT"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"This course is an introduction to statistical thinking and processes, including methods and concepts for discovery and decision-making using data. Topics include descriptive statistics; probability and sampling distributions; statistical inference; correlation and linear regression; analysis of variance, chi-squared, and t-tests; and application of technology for statistical analysis, including the interpretation of the relevance of the statistical findings. Students apply methods and processes to applications using data from a broad range of disciplines.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"s0nEhfoUpr"}],"key":"yQEP8MYtrz"},{"type":"heading","depth":3,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Student Learning Outcomes","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"ofwsuAXUAT"}],"identifier":"student-learning-outcomes","label":"Student Learning Outcomes","html_id":"student-learning-outcomes","implicit":true,"key":"x9N4LtfJIR"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Upon completion of this course, a student will be able to:","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"rgLIDrB5Th"}],"key":"E8Hxc10uae"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":23,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Assess how data were collected and recognize how data collection affects what conclusions can be drawn from the data.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"MddyThTk03"}],"key":"nKsk7ahZXx"}],"key":"rbXoXoJpOz"},{"type":"listItem","spread":true,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Identify appropriate graphs and summary statistics for variables and relationships between them and correctly interpret information from graphs and summary statistics.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"oRMRe5N63G"}],"key":"bLN275QjL2"}],"key":"GH2J9QV92h"},{"type":"listItem","spread":true,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Describe and apply probability concepts and distributions.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"YxZaFBzNBL"}],"key":"gFHoyvHvv4"}],"key":"SjowsPUQdt"},{"type":"listItem","spread":true,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Demonstrate an understanding of, and ability to use, basic ideas of statistical processes, including hypothesis tests and confidence interval estimation.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"LzqTYk6thv"}],"key":"Tlwahz3UHX"}],"key":"im6zJEhHYg"},{"type":"listItem","spread":true,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Identify appropriate statistical techniques and use technology-based statistical analysis to describe, interpret, and communicate results.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"fgQHxTYABO"}],"key":"JrHAn5h25X"}],"key":"KX9HE1xXTM"},{"type":"listItem","spread":true,"position":{"start":{"line":28,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Evaluate ethical issues in statistical practice.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"a3N5X7eNE8"}],"key":"Qv7Zbpz02I"}],"key":"PTDUhymMeP"}],"key":"ddHGUN98xO"},{"type":"heading","depth":2,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Attribution","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"Woni51OdIB"}],"identifier":"attribution","label":"Attribution","html_id":"attribution","implicit":true,"key":"npDjNF8SIZ"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"This content is adapted from ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"