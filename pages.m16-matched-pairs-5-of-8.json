t-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span>","key":"YpZuo1ixlL"},{"type":"text","value":" if the p-value is less than α; otherwise, we do not reject ","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"sGRu5EHtC6"},{"type":"inlineMath","value":"H_0","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>H</mi><mn>0</mn></msub></mrow><annotation encoding=\"application/x-tex\">H_0</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.08125em;\">H</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0813em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span>","key":"NLYRyUYxvz"},{"type":"text","value":".","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"i6Yga5Enzh"}],"key":"IOkIKA1Shk"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"In our example, the p-value is 0.009, indicating that the data provide enough evidence to reject ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"L2X46KWF9I"},{"type":"inlineMath","value":"H_0","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>H</mi><mn>0</mn></msub></mrow><annotation encoding=\"application/x-tex\">H_0</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.08125em;\">H</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0813em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span>","key":"e5K0sWcG6d"},{"type":"text","value":" and conclude that drinking two beers does slow the reaction times of drivers, and thus that drivers are impaired after drinking two beers.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"s6oSN12yYB"}],"key":"VWqS68nAQq"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Comment: Using the Wrong Test","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"B8vuDNjrG7"}],"key":"n2AK5i0yD8"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"It is very important to pay attention to whether the two-sample t-test or the paired t-test is appropriate. In other words, being aware of the study design is extremely important. Consider our example. If we had not “caught” that this is a matched pairs design, and had analyzed the data as if the two samples were independent using the two-sample t-test, we would have obtained a p-value of 0.057.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"JSCJPGUzVu"}],"key":"bF0kMgwEIu"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Note that using this (wrong) method to analyze the data, and a significance level of 0.05, we would conclude that the data do not provide enough evidence for us to conclude that drivers are impaired after drinking two beers. This is an example of how using the wrong statistical method can lead you to wrong conclusions, which in this context could have very serious implications.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"W99OIQh8mZ"}],"key":"AdNJ8cU7yN"}],"class":"important","key":"iv5ePHrgJj"},{"type":"heading","depth":2,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Check Your Understanding: Why Pairing Matters","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"XdHZnrY7yb"}],"identifier":"check-your-understanding-why-pairing-matters","label":"Check Your Understanding: Why Pairing Matters","html_id":"check-your-understanding-why-pairing-matters","implicit":true,"key":"kaqPtoJ0Ul"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-612a97c1bdda77747487ee7393cbf45b.mjs","model":{"question":"Why did the paired analysis (p = 0.009) find a significant effect while the (incorrect) two-sample analysis of the same data (p = 0.057) did not?","choices":[{"correct":true,"text":"The paired analysis removes driver-to-driver variability, making the beer effect easier to detect","feedback":"Correct! Pairing removes the large driver-to-driver differences in baseline reaction time, so the effect of the beers stands out against much less background noise."},{"correct":false,"text":"The paired analysis used more data","feedback":"The data were identical in both analyses—only the method changed."},{"correct":false,"text":"The paired test always gives smaller p-values, making it less trustworthy","feedback":"The paired test doesn't inflate evidence; it correctly uses the design to eliminate irrelevant variability."}],"multi":false,"hint":"What source of variability does pairing remove?","explanation":""},"key":"K15iY4ZLoc"}],"key":"KTVvUGitbU"}],"key":"zOfQ81dmaw"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"The Paired t-Test: Conditions and Test Statistic","url":"/pages/m16-matched-pairs-4-of-8","group":"Section 13: Inference for Relationships"},"next":{"title":"The Paired t-Test: Worked Examples","url":"/pages/m16-matched-pairs-6-of-8","group":"Section 13: Inference for Relationships"}}},"domain":"http://localhost:3000"}