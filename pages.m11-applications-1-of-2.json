":1},"end":{"line":57,"column":1}},"key":"yyWETUIoUQ"}],"key":"XOgWpr8HUr"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-73eca877a522c5138994c2b9b27d024e.mjs","model":{"question":"What is the probability that a randomly chosen test taker scored above 700 on the SAT-M?","choices":[{"correct":true,"text":"About 0.04","feedback":"Correct! P(X > 700) = P(Z > 1.74) = P(Z < −1.74) = 0.0409—about a 4% chance."},{"correct":false,"text":"About 0.96","feedback":"0.9591 is P(Z < 1.74), the probability of scoring BELOW 700."},{"correct":false,"text":"1.74","feedback":"1.74 is the z-score, not the probability."}],"multi":false,"hint":"Standardize first: z = (700 − 507)/111 ≈ 1.74, then find the upper-tail probability.","explanation":""},"key":"IogAyhzzLu"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-73eca877a522c5138994c2b9b27d024e.mjs","model":{"question":"What is the probability that a randomly chosen test taker scored between 400 and 600?","choices":[{"correct":true,"text":"About 0.63","feedback":"Correct! P(400 < X < 600) = P(Z < 0.84) − P(Z < −0.96) = 0.7995 − 0.1685 = 0.631."},{"correct":false,"text":"About 0.80","feedback":"0.80 is only P(Z < 0.84); you must remove the area below 400."},{"correct":false,"text":"About 0.97","feedback":"Adding the two left-tail areas has no probability meaning here—subtract them."}],"multi":false,"hint":"Standardize both: z = (400 − 507)/111 ≈ −0.96 and z = (600 − 507)/111 ≈ 0.84; then subtract left-tail areas (0.7995 − 0.1685).","explanation":""},"key":"nu8ijtD4r4"}],"key":"Ef6UnXMqXL"}],"key":"yvWVyjJdJh"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Working Backward: From Probability to z","url":"/pages/m11-standard-normal-table-3-of-3","group":"Section 8: Random Variables"},"next":{"title":"Normal Applications: From Probabilities to Values","url":"/pages/m11-applications-2-of-2","group":"Section 8: Random Variables"}}},"domain":"http://localhost:3000"}