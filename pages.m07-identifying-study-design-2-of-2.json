{"version":3,"kind":"Article","sha256":"6323fd903b11cbd57b7b64d875344cc8b160e3be21ee3744863f1c9216f9b3f9","slug":"pages.m07-identifying-study-design-2-of-2","location":"/pages/076-m07-identifying-study-design-2-of-2.md","dependencies":[],"frontmatter":{"title":"Identifying Study Designs: Practice with Real Studies","content_includes_title":false,"authors":[{"nameParsed":{"literal":"City College of San Francisco","given":"City College","non_dropping_particle":"of","family":"San Francisco"},"name":"City College of San Francisco","id":"contributors-myst-generated-uid-0"}],"license":{"content":{"id":"CC-BY-NC-SA-4.0","url":"https://creativecommons.org/licenses/by-nc-sa/4.0/","name":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","CC":true}},"numbering":{"title":{"offset":2}},"thumbnail":"/textbook/build/m07-observational-de-86319fef652528b203a6b9ab3d122579.svg","exports":[{"format":"md","filename":"076-m07-identifying-study-design-2-of-2.md","url":"/textbook/build/076-m07-identifying--632b76abcae724f091a62f436253b56c.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Learning Objectives","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bzTS4jwSfr"}],"key":"TWkaV98LBO"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Identify the design of a study (controlled experiment vs. observational study) and other features of the study design (randomized, blind etc.).","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"odCgeUIQd3"}],"key":"NiNekOcVbs"}],"key":"VoTQ1Nj7aM"}],"key":"ilEBdIoGOW"}],"class":"note","key":"IB14vjzukH"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Experiments vs. Observational Studies","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Is4JqVGEq4"}],"identifier":"experiments-vs-observational-studies","label":"Experiments vs. Observational Studies","html_id":"experiments-vs-observational-studies","implicit":true,"key":"v8kiN3ZJfD"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Before assessing the effectiveness of observational studies and experiments for producing evidence of a causal relationship between two variables, we will illustrate the essential differences between these two designs.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"aYZyom9EYB"}],"key":"g0pHypZjD5"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: Quitting Smoking","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"M5JDTw5ibl"}],"key":"bfGSxFOtMX"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Every day, a huge number of people are engaged in a struggle whose outcome could literally affect the length and quality of their life: they are trying to quit smoking. Just the array of techniques, products, and promises available shows that quitting is not easy, nor is its success guaranteed. Researchers would like to determine which of the following is the best method:","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"lFBmUNGux0"}],"key":"uxIgxLu1Dg"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":18,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Drugs that alleviate nicotine addiction.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"TE55suNskf"}],"key":"EH4tgLuXPT"}],"key":"XaeNXu83Ko"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Therapy that trains smokers to quit.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Fe6cuUvDHs"}],"key":"vJRQsbAcpX"}],"key":"uOe1TPlJFz"},{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"A combination of drugs and therapy.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"brSVuTpNmT"}],"key":"X6pAx8N2V8"}],"key":"mQyq1gti5a"},{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Neither form of intervention (quitting “cold turkey”).","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"TVLqybTvaY"}],"key":"WQAInniKK1"}],"key":"L9haW8RvdM"}],"key":"ovVAxsaRZX"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"The explanatory variable is the method (1, 2, 3 or 4), while the response variable is eventual success or failure in quitting. In an observational study, values of the explanatory variable occur naturally. In this case, this means that the participants themselves choose a method of trying to quit smoking. In an experiment, researchers assign the values of the explanatory variable. In other words, they tell people what method to use. Let us consider how we might compare the four techniques, via either an observational study or an experiment.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"krv0shJv8P"}],"key":"FrGfvjC0TS"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":25,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":25,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"An ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"nQxvIt4gOp"},{"type":"emphasis","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"observational study","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"r8eCxjELRs"}],"key":"TuYZHk7IYt"},{"type":"text","value":" of the relationship between these two variables requires us to collect a representative sample from the population of smokers who are beginning to try to quit. We can imagine that a substantial proportion of that population is trying one of the four above methods. In order to obtain a representative sample, we might use a nationwide telephone survey to identify 1,000 smokers who are just beginning to quit smoking. We record which of the four methods the smokers use. One year later, we contact the same 1,000 individuals and determine whether they succeeded.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"OnU5HZ0JMS"}],"key":"eiDKeEdEAB"}],"key":"o7rKUFPtMz"},{"type":"listItem","spread":true,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"In an ","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"AhisttR0pg"},{"type":"emphasis","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"experiment","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"PaGxqXtjWi"}],"key":"VHi9R1pT3H"},{"type":"text","value":", we again collect a representative sample from the population of smokers who are just now trying to quit, using a nationwide telephone survey of 1,000 individuals. This time, however, we divide the sample into 4 groups of 250 and ","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"ans6jUNZM7"},{"type":"emphasis","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"assign","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"WHWUzdKPhX"}],"key":"GnW3FyqoZr"},{"type":"text","value":" each group to use one of the four methods to quit. One year later, we contact the same 1,000 individuals and determine whose attempts succeeded while using our designated method.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"UKDB0HGxNe"}],"key":"eQ00BbFlj7"}],"key":"R0evm02mzP"}],"key":"e4zmm42suu"}],"class":"tip","key":"Y5lbRCJnL8"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"The following figures illustrate the two study designs:","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"FeqQNelmOH"}],"key":"DuW7LGTd6U"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/textbook/build/m07-observational-de-86319fef652528b203a6b9ab3d122579.svg","alt":"A diagram of the observational study. From the population of quitting smokers, a random sample of 1,000 is selected. The sample then divides itself into four groups of uneven sizes, one for each quitting method, because participants choose their own method.","key":"I15MPy8Lc6","urlSource":"images/gen/m07-observational-design.svg"}],"enumerator":"1","key":"OhI4mxALol"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/textbook/build/m07-experiment-desig-243078f85e55eb0d7330bad20d85f86e.svg","alt":"A diagram of the experiment. From the population of quitting smokers, a random sample of 1,000 is selected. The researchers then assign the participants to four equal groups of 250, one for each quitting method.","key":"hZhh1K7DjP","urlSource":"images/gen/m07-experiment-design.svg"}],"enumerator":"2","key":"v9awdzC7hA"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Both the observational study and the experiment begin with a random sample from the population of smokers just now beginning to quit. In both cases, the individuals in the sample can be divided into categories based on the values of the explanatory variable: method used to quit. The response variable is success or failure after one year. Finally, in both cases, we would assess the relationship between the variables by comparing the proportions of success of the individuals using each method, using a two-way table and conditional percentages.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"fcXKvShrIk"}],"key":"mwjP84cyAf"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"The only difference between the two methods is the way the sample is divided into categories for the explanatory variable (method). In the observational study, individuals are divided based upon the method by which they ","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"FWCFbaq5BB"},{"type":"emphasis","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"choose","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"e0omzxHXiC"}],"key":"N2EN5hzJBu"},{"type":"text","value":" to quit smoking. The researcher does not assign the values of the explanatory variable, but rather records them as they naturally occur. In the experiment, the researcher ","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"pfSuBYEGkX"},{"type":"emphasis","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"deliberately assigns","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"METpWI5lA0"}],"key":"ZreyhIGIzR"},{"type":"text","value":" one of the four methods to each individual in the sample. The researcher intervenes by controlling the explanatory variable, and then assesses its relationship with the response variable.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"SvvikDSQu4"}],"key":"LTvMkAymIu"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Now that we have outlined two possible study designs, let’s return to the original question: which of the four methods for quitting smoking is most successful? Suppose the study’s results indicate that individuals who try to quit with the combination drug/therapy method have the highest rate of success, and those who try to quit with neither form of intervention have the lowest rate of success, as illustrated in the hypothetical two-way table below:","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"zeSBHZBqvM"}],"key":"SIabzeyPqv"},{"type":"table","position":{"start":{"line":46,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Method","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"FiWd81YXpA"}],"key":"vdrH2tTbzn"},{"type":"tableCell","header":true,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Quit","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"DKkPd6YsQC"}],"key":"JKw3zbNDPL"},{"type":"tableCell","header":true,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Didn’t Quit","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"q7TOzt385S"}],"key":"i8Cz1Nikhr"},{"type":"tableCell","header":true,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Total","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"dVGHNcemze"}],"key":"u4dYlCpuyZ"},{"type":"tableCell","header":true,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"% Who Quit","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"xGmfAvjZLA"}],"key":"S2NEXtAgzL"}],"key":"VfkeozNl6t"},{"type":"tableRow","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Neither (“cold turkey”)","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"VJoU5y2nJM"}],"key":"cJ805KQO5g"},{"type":"tableCell","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"12","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"jZ196GRvF1"}],"key":"nBILN55kad"},{"type":"tableCell","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"238","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"qFtQHsGHvA"}],"key":"YZpEmjr6cW"},{"type":"tableCell"