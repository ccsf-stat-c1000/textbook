n":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Therapy only","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"Rttcj2PLbk"}],"key":"BU4W2yLIXL"},{"type":"tableCell","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"59","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"qIDIDQOJgn"}],"key":"okid0ZDNU0"},{"type":"tableCell","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"191","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"BDWM7xpvsK"}],"key":"SUFSWC14gz"},{"type":"tableCell","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"250","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"wwP5J2gwsn"}],"key":"vNHdb5bser"},{"type":"tableCell","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"24%","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"T0lvVv6Q1t"}],"key":"SCjtCX4Ohd"}],"key":"B5dK1IAGYB"},{"type":"tableRow","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Drugs & therapy","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"mnFrCPAoya"}],"key":"fR3zvFASQj"},{"type":"tableCell","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"83","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"qPjvHr2lgW"}],"key":"SFzWzOlwOm"},{"type":"tableCell","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"167","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"gWZoOqmS93"}],"key":"upVp6rCsjG"},{"type":"tableCell","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"250","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"Z3uSHAPt8X"}],"key":"EchisZvW0W"},{"type":"tableCell","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"33%","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"E8LsSDNhku"}],"key":"SK1CNDESVA"}],"key":"XmCGTgeWJ9"}],"key":"kf0AU98V6u"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Can we conclude that using the combination drugs and therapy method caused the smokers to quit most successfully? Which type of design was implemented will play an important role in the answer to this question.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"dmY4CtrBbk"}],"key":"DKwytTOxrf"},{"type":"heading","depth":2,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Concept Check","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"Pkd3k0VZG3"}],"identifier":"concept-check","label":"Concept Check","html_id":"concept-check","implicit":true,"key":"p29L6UkLEP"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-e9689e083a3d48b3e46875a14efdf8d0.mjs","model":{"question":"In the observational version of the quitting-smoking study, why can't we safely conclude that the drug-plus-therapy method causes the highest success rate?","choices":[{"correct":true,"text":"Participants chose their own method, so the groups may differ in ways that affect success (lurking variables)","feedback":"Correct! Participants chose their own method, so the groups may differ in important ways (motivation, income, addiction severity)—lurking variables that could explain the differences in success."},{"correct":false,"text":"The sample of 1,000 is too small to draw any conclusion","feedback":"Sample size is not the core problem; even a very large observational study would have self-selected groups."},{"correct":false,"text":"Two-way tables cannot be used to compare success rates","feedback":"A two-way table is an appropriate summary; the issue is how the groups were formed."}],"multi":false,"hint":"Who ended up in the drug-plus-therapy group, and how did they get there?","explanation":""},"key":"H6skZIhK6R"}],"key":"CvogNX9mwV"}],"key":"hYXaQtVOl3"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Observational Study or Experiment? Learning to Tell","url":"/pages/m07-identifying-study-design-1-of-2","group":"Section 2: Designing Studies"},"next":{"title":"Why Observational Studies Struggle to Prove Causation","url":"/pages/m07-causation-and-observational-studies-1-of-2","group":"Section 2: Designing Studies"}}},"domain":"http://localhost:3000"}