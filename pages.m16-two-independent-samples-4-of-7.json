n standard errors) how different our data are from what is claimed in the null hypothesis.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"zA35mmKl1o"}],"key":"Xd9FSlQN5n"}],"key":"pHAOkHzQgU"}],"key":"ON1xgIsgFB"}],"class":"important","key":"aDKKlZ5lWa"},{"type":"heading","depth":2,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Concept Check","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"SiQ4bC9DIu"}],"identifier":"concept-check","label":"Concept Check","html_id":"concept-check","implicit":true,"key":"fStZCn1geY"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-abedf03535fddfc26081d8ab58b0b651.mjs","model":{"question":"A two-sample t-test comparing mean test scores of two teaching methods yields t = −0.85 and a p-value of 0.40. Using α = 0.05, what is the correct conclusion?","choices":[{"correct":true,"text":"Do not reject H₀—there is not enough evidence that the mean scores differ","feedback":"Correct! The p-value is large, so the data do not provide enough evidence of a difference between the two methods' mean scores."},{"correct":false,"text":"Reject H₀ and conclude the methods differ","feedback":"0.40 is much larger than 0.05—the results are not significant."},{"correct":false,"text":"Accept H₀ and conclude the methods are equally effective","feedback":"Failing to reject H₀ does not prove the two methods are equally effective; we simply lack evidence of a difference."}],"multi":false,"hint":"Is 0.40 small?","explanation":""},"key":"ObjFteTtQX"}],"key":"JInoXJbWZP"}],"key":"U5Jt8y7GVH"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Two Independent Samples (3 of 7)","url":"/pages/m16-two-independent-samples-3-of-7","group":"Section 13: Inference for Relationships"},"next":{"title":"Two Independent Samples (5 of 7)","url":"/pages/m16-two-independent-samples-5-of-7","group":"Section 13: Infe