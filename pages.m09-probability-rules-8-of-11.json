qbz"},{"type":"emphasis","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"none","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"zSjTeLjbHi"}],"key":"ZwzvbkRmL7"},{"type":"text","value":" of the 10 has blood type O.”","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"mY2IaD18Qp"}],"key":"z28VT42RQJ"}],"key":"M6scbn2oXS"},{"type":"listItem","spread":true,"position":{"start":{"line":23,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The complement to “getting ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"TS4toDt7Ti"},{"type":"emphasis","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"at least one","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"oHFMmqqOBP"}],"key":"WqXjgWP0Zp"},{"type":"text","value":" question right” is “getting ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"KgePz4pxZq"},{"type":"emphasis","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"none","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"BUxiY9CXNL"}],"key":"YzKts1lazn"},{"type":"text","value":" of the questions right.”","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"NBl1NbIeae"}],"key":"Vb84RYwQ21"}],"key":"UAN4XUuzXq"}],"key":"rrm0byYeiI"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"(Note how “at least one of” changes to “none” in the complement.)","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"Uw4JhSFGNu"}],"key":"AMQOTsRR3c"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"We’ll start with a very simple example in which it is still manageable to find P(at least one of ...) directly, without using the complement rule. Then we’ll alter the example slightly and see how trying to find P(at least one of ...) directly can get ","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"nOljDpYlnB"},{"type":"emphasis","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"VERY COMPLICATED","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"MLWNIySJRg"}],"key":"dOasW0NOU5"},{"type":"text","value":", and how the complement rule comes to the rescue. Finally, you’ll check your understanding by attempting to solve a similar problem yourself.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"bRysQmQRGN"}],"key":"LdkCsPDbDb"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: At Least One of Two","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"YhtW3P8EX7"}],"key":"A0xoIWzctY"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Two people are selected at random. What is the probability that at least one of them has blood type O?","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"pSHG2tiTkA"}],"key":"cZngcb2PKd"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Here is our sample space: S = { (O, O), (O, not O), (not O, O), (not O, not O) }","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"GxeJJiwUmj"}],"key":"owXeAhhJZS"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"The event “at least one person chosen has blood type O” consists of the first three possible outcomes, and therefore:","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"MrBnnyzkce"}],"key":"sxWiEgExTK"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"P(at least one person chosen has blood type O) = P((O and O) or (O and not O) or (not O and O)) = (0.44 × 0.44) + (0.44 × 0.56) + (0.56 × 0.44) = 0.6864.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"MXI32FHaH8"}],"key":"w7SB5hxSWb"}],"class":"tip","key":"j4g3Kew2EC"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Now we’ll just alter the example slightly by randomly choosing 10 people instead of 2:","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"yPtwpmNsFI"}],"key":"rL6e7ibxLe"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: At Least One of Ten","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"py9AGilHzG"}],"key":"OJLFNCCl2m"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"A patient with blood type O desperately needs a blood transfusion. Since a person with blood type O can receive blood only from another person who has blood type O, the blood bank decides to choose 10 donors at random and hope that at least one of them has blood type O. Find P(at least one of the 10 donors has blood type O). To make things simpler, let’s denote the event “at least one has blood type O” by L (for at ","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"MWDQkJIawz"},{"type":"emphasis","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"L","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"I1YJFjEqJF"}],"key":"fYzYkKvYVK"},{"type":"text","value":"east).","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"QTxfARtPfv"}],"key":"GTjB2UMm4X"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Solving this using the brute force method would require a prohibitive amount of work. As before, we would need to list all the possible outcomes of blood types of 10 people (using either “O” or “not O”), but this time there are 1,024 of them! We would then need to identify those outcomes that L consists of (i.e., the outcomes in which at least one of the 10 people has blood type O). Next, we would need to find the probability of each of those outcomes and add those probabilities up. ","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"DPyuDEUtq3"},{"type":"emphasis","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"What a pain!","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"uDaQ1aJa6Y"}],"key":"lRkgoUOY8l"},{"type":"text","value":" There must be a better way.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"lCcp6xaqEq"}],"key":"Tl5CvCGzFv"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Instead of doing all the work listed above, we can use the Complement Rule, which says P(L) = 1 − P(not L). As we explained before, in this case “not L” is the event “none of the 10 have blood type O,” or in other words that all 10 have a blood type other than O. So we can simply solve (using our regular notation from this module):","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"bwVuVHjwDM"}],"key":"apq2cTc5YG"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"P(L) = 1 − P(not L) = 1 − P(not O1 ","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"idrWSC0VA9"},{"type":"emphasis","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"and","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"b2UwGSPbE3"}],"key":"lhOSFm9eiC"},{"type":"text","value":" not O2 ","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"tVVSW4OfCn"},{"type":"emphasis","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"and","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"ZjPrQZIfHJ"}],"key":"HmqCCk9cfO"},{"type":"text","value":" ... ","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"es1kltnK2j"},{"type":"emphasis","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"and","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"ARo8Nt0FGB"}],"key":"uzDPggZB6p"},{"type":"text","value":" not O10)","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"EgOqAgKVfS"}],"key":"t1GUsBDxZS"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"Now, using the multiplication rule,","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"HYKEYkclLv"}],"key":"bhszsp040L"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"P(L) = 1 − (0.56)¹⁰ = 1 − 0.003 = 0.997","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"EHezFQRmGM"}],"key":"YP8cMFQa7W"},{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Therefore, it is almost certain that if we choose 10 people at random, we’ll find that at least one of them has blood type O. This result makes sense, since 44% have blood type O, and so out of 10 people it is almost certain that at least one will have blood type O.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"ehgaC9DSv6"}],"key":"AWhk6NYcC4"}],"class":"tip","key":"yRdprBNStr"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"The purpose of the following activity is to guide you through another problem that involves finding P(at least one of ...).","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"YB8Ir2IAe5"}],"key":"fi5Dftwcll"},{"type":"heading","depth":2,"position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Check Your Understanding: Finding “At Least One” Probabilities","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"wnxu2aCJPO"}],"identifier":"check-your-understanding-finding-at-least-one-probabilities","label":"Check Your Understanding: Finding “At Least One” Probabilities","html_id":"check-your-understanding-finding-at-least-one-probabilities","implicit":true,"key":"VDTH1BQvOb"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"A quiz consists of 10 multiple-choice questions, each with 4 possible answers, only one of which is correct. A student who does not attend lectures on a regular basis has no clue what the answers are, and therefore uses an independent random guess to answer each of the 10 questions. What is the probability that the student gets at least one question right?","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"mpT6ikRksi"}],"key":"dLHkyKSaWh"},{"type":"paragraph","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"Let’s decide on some notations. Let L be the event that the student gets at least one of the questions right. We’ll use R for getting a question right and W for getting it wrong (W is essentially “not R”).","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"jK7fDi8gEZ"}],"key":"gB0lWH43YL"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-1352b69057e2d535d842eb760b60a8f5.mjs","model":{"question":"What is the probability of getting a single question wrong, P(W)?","choices":[{"correct":false,"text":"1/4","feedback":"1/4 is the probability of guessing right; wrong is its complement."},{"correct":true,"text":"3/4","feedback":"Correct! P(W) = 1 − 1/4 = 3/4."},{"correct":false,"text":"1/10","feedback":"With 4 choices per question, the chance of a wrong guess is 3 out of 4."}],"multi":false,"hint":"One of the 4 choices is right, so 3 are wrong.","explanation":""},"key":"r5obrnmqsa"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-1352b69057e2d535d842eb760b60a8f5.mjs","model":{"question":"What is \"not L,\" the complement of \"at least one question right,\" and what is its probability?","choices":[{"correct":true,"text":"\"All 10 questions wrong\"; P(not L) = (3/4)¹⁰ ≈ 0.056","feedback":"Correct! \"Not L\" is getting all 10 questions wrong: P(not L) = (3/4)¹⁰ ≈ 0.056."},{"correct":false,"text":"\"At least one question wrong\"; P(not L) = 3/4","feedback":"\"Getting at least one wrong\" is not the complement of \"getting at least one right\"—both can happen together."},{"correct":false,"text":"\"All 10 questions wrong\"; P(not L) = 10 × (3/4)","feedback":"Add up? No—the 10 wrong guesses must ALL happen, so we multiply: (3/4)¹⁰."}],"multi":false,"hint":"The complement of \"at least one right\" is \"all wrong\"; the guesses are independent.","explanation":""},"key":"q5hzzsFZfl"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-1352b69057e2d535d842eb760b60a8f5.mjs","model":{"question":"So what is P(L), the probability that the student gets at least one question right?","choices":[{"correct":true,"text":"About 0.944","feedback":"Correct! P(L) = 1 − (3/4)¹⁰ ≈ 1 − 0.056 = 0.944."},{"correct":false,"text":"About 0.056","feedback":"0.056 is P(not L), the probability of getting every question wrong."},{"correct":false,"text":"0.25","feedback":"0.25 is the chance of getting one particular question right, not at least one of the ten."}],"multi":false,"hint":"Apply the Complement Rule: P(L) = 1 − P(not L).","explanation":""},"key":"kDNMjZEuWw"}],"key":"t41rw90LBL"}],"key":"l3ZwnirjEK"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Extending the Rules: More Than Two Events","url":"/pages/m09-probability-rules-7-of-11","group":"Section 6: Finding Probability of Events"},"next":{"title":"The General Addition Rule: Handling Overlap","url":"/pages/m09-probability-rules-9-of-11","group":"Section 6: Finding Probability of Events"}}},"domain":"http://localhost:3000"}