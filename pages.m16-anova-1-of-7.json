{"version":3,"kind":"Article","sha256":"dfce90a04cc73614ff265cb5d581ad40fc8904eaa49c6c930a798bb70e5e68cb","slug":"pages.m16-anova-1-of-7","location":"/pages/246-m16-anova-1-of-7.md","dependencies":[],"frontmatter":{"title":"Comparing More Than Two Means: ANOVA","content_includes_title":false,"authors":[{"nameParsed":{"literal":"City College of San Francisco","given":"City College","non_dropping_particle":"of","family":"San Francisco"},"name":"City College of San Francisco","id":"contributors-myst-generated-uid-0"}],"license":{"content":{"id":"CC-BY-NC-SA-4.0","url":"https://creativecommons.org/licenses/by-nc-sa/4.0/","name":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","CC":true}},"abbreviations":{"ANOVA":"Analysis of Variance","CI":"Confidence Interval","CLT":"Central Limit Theorem","EDA":"Exploratory Data Analysis","IQR":"Interquartile Range","SD":"Standard Deviation","SE":"Standard Error","SRS":"Simple Random Sample","INCREASE":null,"INCREASED":null,"DECREASES":null,"OBSERVED":null,"ROSE":null},"numbering":{"title":{"offset":2}},"thumbnail":"/textbook/build/m16-anova-design-f0fbfbba5ab0335bed2c2246a173678b.svg","exports":[{"format":"md","filename":"246-m16-anova-1-of-7.md","url":"/textbook/build/246-m16-anova-1-of-7-4298d67f28ab167ddd40b08a256766c7.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Comparing More Than Two Means—","key":"d1TXnr5uqz"},{"type":"abbreviation","title":"Analysis of Variance","children":[{"type":"text","value":"ANOVA","key":"kcpLWYF5M4"}],"key":"qzM5imMdsp"}],"identifier":"comparing-more-than-two-means-anova","label":"Comparing More Than Two Means—ANOVA","html_id":"comparing-more-than-two-means-anova","implicit":true,"key":"DuW4RwmYCx"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"t