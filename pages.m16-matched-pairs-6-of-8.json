":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"mhuQDB85Bz"},{"type":"emphasis","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"before","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"fnMyWkdvQx"}],"key":"bZQEI0CHca"},{"type":"text","value":" looking at the data. It would be ethically wrong to look at the histogram of differences, note that most of the differences are negative, and then decide to carry out the one-sided test that the data seem to support. This is known as “data snooping,” and is considered to be a very bad statistical practice.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"Xjejvfa0VN"}],"key":"fEH1gDy7u1"}],"class":"important","key":"hNXwEe5KcZ"},{"type":"heading","depth":2,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Check Your Understanding: The Danger of Data Snooping","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"YQILMU7ZI2"}],"identifier":"check-your-understanding-the-danger-of-data-snooping","label":"Check Your Understanding: The Danger of Data Snooping","html_id":"check-your-understanding-the-danger-of-data-snooping","implicit":true,"key":"LG19yJaT2V"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-0e29ae0bec3a8408692689b04ac6d4d1.mjs","model":{"question":"A researcher collects paired data, looks at the results, notices the sample mean difference is positive, and only then chooses the alternative $H_a$: $\\mu_d > 0$ to get a smaller p-value. What is wrong with this?","choices":[{"correct":true,"text":"The alternative was chosen after seeing the data, which invalidates the p-value—this is data snooping","feedback":"Correct! Choosing the alternative after peeking at the data (\"data snooping\") makes the reported p-value misleadingly small—hypotheses must be set before examining the data."},{"correct":false,"text":"One-sided alternatives are never allowed","feedback":"One-sided alternatives are legitimate when justified in advance; the problem is choosing one AFTER seeing the data."},{"correct":false,"text":"Nothing—the calculation is correct, so the practice is fine","feedback":"The calculation may be arithmetically right, but the inference is invalid because the hypothesis was chosen to fit the data."}],"multi":false,"hint":"When must hypotheses be set?","explanation":""},"key":"Qqr0iBhkkR"}],"key":"qys7fRYIRf"}],"key":"Djilwu7b6o"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"The Paired t-Test: P-value and Conclusion","url":"/pages/m16-matched-pairs-5-of-8","group":"Section 13: Inference for Relationships"},"next":{"title":"A Confidence Interval for the Mean Difference","url":"/pages/m16-matched-pairs-7-of-8","group":"Section 13: Inference for Relationships"}}},"domain":"http://localhost:3000"}