"1.2 is the sample standard deviation, which estimates $\\sigma$."},{"correct":false,"text":"0.33","feedback":"171/513 estimates a proportion, not this mean."}],"multi":false,"hint":"Use the sample mean.","explanation":""},"key":"dCe3rBR95F"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-ab552a073177c801fc08fc2e7e8860b3.mjs","model":{"question":"What is the point estimate for p, the proportion of newlywed couples who go out more than twice a week?","choices":[{"correct":true,"text":"$171/513 \\approx 0.33$","feedback":"Correct! p-hat = $171/513 \\approx 0.33$."},{"correct":false,"text":"2.35","feedback":"2.35 estimates the mean of the other variable."},{"correct":false,"text":"171","feedback":"171 is the raw count; divide by the sample size 513."}],"multi":false,"hint":"171 of the 513 couples said yes.","explanation":""},"key":"v2lDsZZ1js"}],"key":"COHnt7G8uv"}],"key":"RQdlaHGIFl"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Inference For One Variable","url":"/pages/m13-inference-for-one-variable","group":"Section 10: Introduction to Inference"},"next":{"title":"What Makes a Good Point Estimator?","url":"/pages/m14-point-estimation-2-of-2","group":"Section 11: Estimation"}}},"domain":"http://localhost:3000"}