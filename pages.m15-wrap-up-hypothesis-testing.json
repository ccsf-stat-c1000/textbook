mn":1}},"key":"nlXp7XNz4E"}],"key":"z7vKtjt5oI"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"In this module, we learned how to compute the p-value for the two z-tests (z-test for the population proportion and the z-test for the population mean). However, for the t-test (and, actually, from this point on in the course), we will use software to find the p-value for us.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"Y0WWJuHpLE"}],"key":"aIaIUpA4yc"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"IV. Making conclusions.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"Ldsng50jBK"}],"key":"TRDHjYNOcw"}],"key":"bh6BOyaAvt"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"-Conclusions about the significance of the results:","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"C0CRr64n3l"}],"key":"wh6FnkOtim"}],"key":"RXFGaDPh0m"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"If the p-value is small, the data present enough evidence to reject H~0~ (and accept H~a~).","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"dcTb5tiEqa"}],"key":"KwEnJTbKOA"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"If the p-value is not small, the data do not provide enough evidence to reject H~0~.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"VRAVloOsEm"}],"key":"K4scnLlEWo"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"To help guide our decision, we use the significance level as a cutoff for what is considered a small p-value. The significance cutoff is usually set at .05, but should not be considered inviolable.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"suXd3dQvB3"}],"key":"AksJ1vOSnj"},{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"Conclusions should always be made in the context of the problem.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"mwhHNtVcSs"}],"key":"eLUb6u4iiq"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Additional ‘Big Ideas’ about hypothesis Testing.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"fAMeZCZWDT"}],"key":"Kg3m5GZvZU"}],"key":"D3zxwkUAW9"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Note:","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"vhXcHEETKq"}],"key":"L8kJ5KGKa7"},{"type":"text","value":" These ideas were already mentioned in the summary for hypothesis testing for the population proportion p, however it is worth repeating them and thus stress that these idea apply to hypothesis testing in general!","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"eTghGjGyWy"}],"key":"JjB0gVi5zv"}],"key":"ley6wbISXE"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"Results that are based on a larger sample carry more weight, and therefore results that are not significant (do not provide evidence to reject H~0~) may become significant if based on a larger sample size. As a result...","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"Fk3a4mcivF"}],"key":"BZDSVsnewm"},{"type":"paragraph","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"Even a very small and practically unimportant effect becomes statistically significant with a large enough sample size. The distinction between statistical significance and practical importance should therefore always be considered.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"kuYHqxAzRq"}],"key":"VRmsXQ8prU"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"For given data, the p-value of the two-sided test is always twice as large as the p-value of the one-sided test. It is therefore harder to reject H~0~in the two-sided case than it is in the one-sided case in the sense that stronger evidence is required. Intuitively, the hunch or information that leads us to use the one-sided test can be regarded as a head-start toward the goal of rejecting H~0~.","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"NNegjiqAIq"}],"key":"Irc9fQBIoE"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"95% confidence intervals","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"gahjKtQvb5"}],"key":"cftyN3Ohfx"},{"type":"text","value":"can be used in order to carry out ","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"IcOco7X1Ay"},{"type":"emphasis","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"two-sided tests","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"z5EiyBSFi0"}],"key":"d8suSuG4RG"},{"type":"text","value":" (at the .05 significance level). If the null value is not included in the confidence interval (i.e., is not one of the plausible values for the parameter), we have enough evidence to reject H~0~. Otherwise, we cannot reject H~0~.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"xVICmB7Xzn"}],"key":"g6CgZbUzEh"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"If the results are significant, it might be of interest to follow up the tests with a confidence interval in order to get insight into the actual value of the parameter of interest.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"iULs3vUvWD"}],"key":"GQWyFYY8GI"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"The following StatTutor exercise is the first one in which the “More Formal Analysis” (i.e., “inference”) node is active. This exercise will therefore give you a chance to practice some of the methods you learned, but most importantly, will give you a sense of how inference fits into and completes the big picture of statistics.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"wPPq08wI3i"}],"key":"Eins02yoW6"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"QsyLfcvOPV"}],"key":"DnUqf8eEhG"},{"type":"code","lang":"","value":"**Lab**\n\nCell Phones\n\n*(Interactive activity — available in the OLI platform)*","position":{"start":{"line":78,"column":1},"end":{"line":82,"column":1}},"key":"E9yTbRO9OO"}],"key":"Qoof270dnC"},{"type":"heading","depth":2,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"End of Section Questions","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"Gt1TVRMsHN"}],"identifier":"end-of-section-questions","label":"End of Section Questions","html_id":"end-of-section-questions","implicit":true,"key":"WV9vuZXddU"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"MCiDq1J1WL"}],"key":"Fo6I8mtevo"},{"type":"code","lang":"","value":"**My Response**\n\nAbout Inference for One Variable\n\n*(Interactive activity — available in the OLI platform)*","position":{"start":{"line":88,"column":1},"end":{"line":92,"column":1}},"key":"JsXMckGn05"}],"key":"SR48B4yO7J"}],"key":"i1W2dBTn0t"}],"key":"L6RfY6wuqK"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Hypothesis Testing for the Population Mean (9 of 9)","url":"/pages/m15-hypothesis-testing-for-the-population-mean-9-o","group":"Section 15: Hypothesis Testing"},"next":{"title":"Type I and Type II Errors","url":"/pages/m15-type-i-and-type-ii-errors","group":"Section 15: Hypothesis Testing"}}},"domain":"http://localhost:3000"}