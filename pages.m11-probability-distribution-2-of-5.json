xt","value":"A coin is tossed three times. Let the random variable X be the number of tails. Find the probability distribution of X. We’ll follow the same reasoning we used in the previous example:","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"GkclNpYwWv"}],"key":"wxFjMbQMFF"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"First, we specify the 8 possible outcomes in S, along with the probability of each outcome, and figure out the value of X (number of tails) for each. (Because they are all equally likely, each has probability 1/8. Alternatively, by the multiplication principle, each particular sequence of three coin faces has probability 1/2 × 1/2 × 1/2 = 1/8.)","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"D7l7eWSdqX"}],"key":"wymQWripLt"},{"type":"table","position":{"start":{"line":12,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Outcome","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"LcVbwcnG8y"}],"key":"xq36Go7djB"},{"type":"tableCell","header":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Probability","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"Se5YO6H5dR"}],"key":"JuCmxVJ1JK"},{"type":"tableCell","header":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"X","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"ilbdCBuxOR"}],"key":"mhOQhczfsA"}],"key":"Sb92F5pxfH"},{"type":"tableRow","position":{"start":{"line":14,"column":1},"end":{"line":