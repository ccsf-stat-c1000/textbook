xt","value":"A coin is tossed three times. Let the random variable X be the number of tails. Find the probability distribution of X. We’ll follow the same reasoning we used in the previous example:","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"ybKvXD00o0"}],"key":"njGat733sI"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"First, we specify the 8 possible outcomes in S, along with the probability of each outcome, and figure out the value of X (number of tails) for each. (Because they are all equally likely, each has probability 1/8. Alternatively, by the multiplication principle, each particular sequence of three coin faces has probability 1/2 × 1/2 × 1/2 = 1/8.)","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"R6K5iiKc3Q"}],"key":"S3ywejfiep"},{"type":"table","position":{"start":{"line":12,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Outcome","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"xXtQJnztIg"}],"key":"z4cRt6Edh5"},{"type":"tableCell","header":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Probability","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"lrYH9T13Rk"}],"key":"HrupNrIhSu"},{"type":"tableCell","header":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"X","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"b9S9Dp6oC7"}],"key":"vhTQKhWDKV"}],"key":"xOsUqCgHtd"},{"type":"tableRow","position":{"start":{"line":14,"column":1},"end":{"line":