)^2 = 256$."}],"multi":false,"hint":"$n = \\left(\\frac{z^{*}\\sigma}{m}\\right)^{2} = \\left(\\frac{2(16)}{2}\\right)^{2}$.","explanation":""},"key":"GHDvlvkKyN"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Comment","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"LaHec8erSa"}],"key":"gg3ARAjmU8"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"In the preceding activity, you saw that in order to calculate the sample size when planning a study, you needed to know the population standard deviation, sigma ","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"z3QPH5sNZh"},{"type":"inlineMath","value":"(\\sigma)","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo stretchy=\"false\">(</mo><mi>σ</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">(\\sigma)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">(</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">σ</span><span class=\"mclose\">)</span></span></span></span>","key":"OgYI7MQlKp"},{"type":"text","value":". In practice, sigma is usually not known, because it is a parameter. (The rare exceptions are certain variables like IQ score or standardized tests that might be constructed to have a particular known sigma.)","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"USxSsAgwYC"}],"key":"kI4J0rMYP9"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Therefore, when researchers wish to compute the required sample size in preparation for a study, they use an ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"U6n7wOncfz"},{"type":"emphasis","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"estimate","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"a4XS6oTWnQ"}],"key":"ivOzevCdvZ"},{"type":"text","value":" of sigma. Usually, sigma is estimated based on the standard deviation obtained in prior studies.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"pxkVnXnwL1"}],"key":"pPkJwwR9DG"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"However, in some cases, there might not be any prior studies on the topic. In such instances, a researcher still needs to get a rough estimate of the standard deviation of the (yet-to-be-measured) variable, in order to determine the required sample size for the study. One way to get such a rough estimate is with the “range rule of thumb.”","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"IW5KvuEGH8"}],"key":"zqOWK6Z8VC"}],"class":"important","key":"faUoGtw9cD"},{"type":"heading","depth":2,"position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"Check Your Understanding: Estimating Sigma with the Range Rule","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"G4xeQAZW21"}],"identifier":"check-your-understanding-estimating-sigma-with-the-range-rule","label":"Check Your Understanding: Estimating Sigma with the Range Rule","html_id":"check-your-understanding-estimating-sigma-with-the-range-rule","implicit":true,"key":"ArdNLXMyuU"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"An increasing global population requires more food from crops. With the world’s farmland limited due to overuse and a warming globe, one solution may come from crops that are genetically engineered to grow in harsh desert soil.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"YIkHA3tTnY"}],"key":"DGKD3TqpVV"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"Suppose that an agricultural researcher has just genetically engineered a brand new type of corn, never before tested, which the researcher hopes will yield a sufficient number of kernels of corn when grown in harsh desert soil. In order to test the corn, the researcher will grow a certain number of ears of the new corn in harsh desert soil, and will count and record the number of kernels per ear. The researcher needs your statistical help in computing the minimum number of ears of the new corn that will be needed for the study.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"DLw3QPJOnI"}],"key":"CuEeCRm2KL"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"In the formula for the required number (n) of ears of corn, we need to know sigma—here, the standard deviation of the number of kernels per ear for the population of all ears of the new corn. Since the corn is brand new, there are no prior studies to estimate sigma from.","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"DdCH5WqtUb"}],"key":"YJjdUeYDFe"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"So the researcher can use the “range rule of thumb,” which says that, to a rough approximation, sigma is no bigger than range/4, where range = max - min. If you have no other estimate for sigma, you can therefore use range/4 as a rough estimate.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"k6L2tNUyYC"}],"key":"SnK36658xg"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"To use range/4, we need to estimate the range of the number of kernels on an ear of the new experimental corn. An ordinary ear of corn has around 800 kernels. We don’t know how few or how many kernels each ear of the experimental corn will have, but at the very minimum it could have zero (if the new corn didn’t produce any kernels at all); and even if the new corn actually over-produces compared to existing corn (despite being grown in harsh conditions), it certainly isn’t going to overproduce by more than twice, so the maximum number of kernels can’t be larger than 1,600.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"jWgTKk1Z53"}],"key":"pp9GyZh3Tx"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-25d2578daaee263925d723f08bb887bd.mjs","model":{"question":"Using the range rule of thumb, what is the rough estimate for sigma?","choices":[{"correct":true,"text":"400","feedback":"Correct! $\\sigma \\approx (1600 - 0)/4 = 400$ kernels."},{"correct":false,"text":"800","feedback":"800 is the typical number of kernels, not the range divided by 4."},{"correct":false,"text":"200","feedback":"Divide the range by 4, not by 2."}],"multi":false,"hint":"Range = $1{,}600 - 0$; sigma $\\approx$ range/4.","explanation":""},"key":"aqoxe8B09p"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-25d2578daaee263925d723f08bb887bd.mjs","model":{"question":"Using $\\sigma \\approx 400$, how many ears of corn must be grown to estimate the mean number of kernels with 95% confidence and a margin of error of 50 kernels?","choices":[{"correct":true,"text":"256","feedback":"Correct! $n = (800/50)^2 = 16^2 = 256$ ears of corn."},{"correct":false,"text":"16","feedback":"Don't forget to square the quantity: $(16)^2 = 256$."},{"correct":false,"text":"1,024","feedback":"Use z* = 2 for 95% confidence."}],"multi":false,"hint":"$n = (2 \\times 400/50)^2$.","explanation":""},"key":"CAaRKA2F25"}],"key":"trY4jgIDoZ"}],"key":"ogiqH8xKIu"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Margin of Error and the Precision of an Interval","url":"/pages/p187-m14-confidence-intervals-for-the-population-m","group":"Section 11: Estimation"},"next":{"title":"When Is It Safe to Use This Interval?","url":"/pages/p189-m14-confidence-intervals-for-the-population-m","group":"Section 11: Estimation"}}},"domain":"http://localhost:3000"}