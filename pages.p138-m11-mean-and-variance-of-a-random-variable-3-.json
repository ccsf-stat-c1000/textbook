ine":55,"column":1},"end":{"line":55,"column":1}},"key":"EDnvpP1fVp"}],"key":"pm1n4pS5nM"}],"key":"PmGVqRa1Vs"},{"type":"listItem","spread":true,"position":{"start":{"line":56,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The probability of 50% damage (due to fire) to a house in that area and of the size of your customer’s house is 0.008 (in which case the insurance company will pay only $50,000 to the customer).","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"bXqLjE9KZT"}],"key":"vVb3hD7h3A"}],"key":"PXafnEikG8"}],"key":"r6ewgXOWIa"},{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"For simplicity, we’ll ignore any other partial losses.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"WtFOk0Fi4I"}],"key":"ptl570OAcV"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Let the random variable X be the insurance company’s annual gain from such a policy (i.e., the amount of money made by the insurance company from such a policy).","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"SbLh4cGojQ"}],"key":"sN2cKDLz01"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-d23abc9edca1b45ec2418c4dfb0f8102.mjs","model":{"question":"What are the possible values of X and their probabilities?","choices":[{"correct":true,"text":"-98,650 (0.002); -48,650 (0.008); +1,350 (0.990)","feedback":"Correct! Total loss: $1350 - 100{,}000 = -98{,}650$ (prob 0.002); 50% damage: $1350 - 50{,}000 = -48{,}650$ (prob 0.008); no fire: +1350 (prob 0.990)."},{"correct":false,"text":"-100,000 (0.002); -50,000 (0.008); +1,350 (0.990)","feedback":"Don't forget that the company keeps the premium in every case—subtract payouts from 1350."},{"correct":false,"text":"-98,650 (0.002); -48,650 (0.008); +1,350 (0.980)","feedback":"The no-fire probability is $1 - 0.002 - 0.008 = 0.990$."}],"multi":false,"hint":"The company always collects the \\$1,350 premium, and pays out \\$100,000, \\$50,000, or nothing.","explanation":""},"key":"Ln88isqLQQ"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-d23abc9edca1b45ec2418c4dfb0f8102.mjs","model":{"question":"What is the company's expected annual gain from this policy?","choices":[{"correct":true,"text":"\\$750","feedback":"Correct! $\\mu(X) = -197.30 - 389.20 + 1{,}336.50$ = \\$750."},{"correct":false,"text":"\\$1,350","feedback":"\\$1,350 ignores the fire payouts, which lower the long-run average."},{"correct":false,"text":"\\$550","feedback":"Check the arithmetic: the three weighted terms are -197.30, -389.20, and +1,336.50."}],"multi":false,"hint":"$\\mu(X) = (-98{,}650)(0.002) + (-48{,}650)(0.008) + (1{,}350)(0.990)$.","explanation":""},"key":"Yo1Zny97ZZ"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-d23abc9edca1b45ec2418c4dfb0f8102.mjs","model":{"question":"Which is the best interpretation of this expected gain?","choices":[{"correct":true,"text":"In the long run, the company averages a gain of $750 per policy per year","feedback":"Correct! Over many, many policies of this kind, the company gains an average of \\$750 per policy per year—even though on any single policy it either gains \\$1,350 or takes a large loss."},{"correct":false,"text":"The company earns exactly $750 from this customer each year","feedback":"On any single policy the gain is never exactly \\$750; the mean describes the long-run average."},{"correct":false,"text":"The company can never lose money on this policy","feedback":"The company can absolutely lose money on an individual policy (when a fire occurs)—just not on average across many policies."}],"multi":false,"hint":"Expected value describes a long-run average.","explanation":""},"key":"F6XXjuBZjy"}],"key":"pUKZRoOv6K"}],"key":"VrB1SeB2mg"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Expected Value: What Happens in the Long Run","url":"/pages/p137-m11-mean-and-variance-of-a-random-variable-2-","group":"Section 8: Random Variables"},"next":{"title":"The Variance and Standard Deviation of a Random Variable","url":"/pages/p139-m11-mean-and-variance-of-a-random-variable-4-","group":"Section 8: Random Variables"}}},"domain":"http://localhost:3000"}