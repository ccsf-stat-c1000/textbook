:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.13889em;\">P</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">μ</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6835em;vertical-align:-0.0391em;\"></span><span class=\"mord\">2</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">σ</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&lt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7224em;vertical-align:-0.0391em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.07847em;\">X</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&lt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7778em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">μ</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">2</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">σ</span><span class=\"mclose\">)</span></span></span></span>","key":"I5PkzXbkyR"}],"key":"Q0gQm9tnb3"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"inlineMath","value":"0.997=P(\\mu-3\\sigma<X<\\mu+3\\sigma)","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>0.997</mn><mo>=</mo><mi>P</mi><mo stretchy=\"false\">(</mo><mi>μ</mi><mo>−</mo><mn>3</mn><mi>σ</mi><mo>&lt;</mo><mi>X</mi><mo>&lt;</mo><mi>μ</mi><mo>+</mo><mn>3</mn><mi>σ</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">0.997=P(\\mu-3\\sigma&lt;X&lt;\\mu+3\\sigma)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.997</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.13889em;\">P</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">μ</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6835em;vertical-align:-0.0391em;\"></span><span class=\"mord\">3</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">σ</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&lt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7224em;vertical-align:-0.0391em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.07847em;\">X</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&lt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7778em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">μ</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">3</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">σ</span><span class=\"mclose\">)</span></span></span></span>","key":"kH0eLq7pwA"}],"key":"tDkRvoXi1o"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/textbook/build/image121-10aaf39806be1edfc0d2773aa0acda62.gif","alt":"A normal bell curve with some ranges marked. At the center (peak) of the bell curve is μ. The area under the bell curve between μ-σ < X < μ+σ compromises of 0.68 of the total area under the bell curve (which is 1). The area under the bell curve between μ-2σ < X < μ+2σ is 0.95 of the total area under the curve. Capturing even more area under the bell curve is the range of μ-3σ < X < μ+3σ, which is 0.997 of the total area under the curve.","key":"fLW03u4bwq","urlSource":"images/image121.gif"}],"enumerator":"1","key":"vxoEkikd0i"},{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Comment","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"eECroian0U"}],"identifier":"comment","label":"Comment","html_id":"comment","implicit":true,"key":"aL6a09njPy"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Notice that the information from the rule can be interpreted from the perspective of the tails of the normal curve: since .68 is the probability of being within 1 standard deviation of the mean, (1 - .68) / 2 = .16 is the probability of being further than 1 standard deviation below the mean (or further than 1 standard deviation above the mean). Likewise, (1 - .95) / 2 = .025 is the probability of being more than 2 standard deviations below (or above) the mean; (1 - .997) / 2 = .0015 is the probability of being more than 3 standard deviations below (or above) the mean. The three figures below illustrate this.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"zoMAH0A8gL"}],"key":"NWZJCGcMF3"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/textbook/build/image122-c5d82cd203380336d2f44c231ab0ff54.gif","alt":"A normal bell curve, in which μ, μ-σ, and μ+σ have been marked on the horizontal axis. The probability of being within one standard deviation of μ, or between μ-σ and μ+σ, is .68 . The probability of being below one standard deviation from the mean is the area under the bell curve to the left of μ-σ which is .16 . Likewise, the probability of being further than one standard deviation above the mean is the area under the bell curve to the right of μ+σ, which is .16 .","key":"brqFiti6aH","urlSource":"images/image122.gif"}],"enumerator":"2","key":"wCzPGZrAAJ"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/textbook/build/image123-11a8d2f2c058f3a888b406f5994c8798.gif","alt":"A normal bell curve. The probability of being within two standard deviation of μ is .95 . The probability of being further than two standard deviations below the mean is the area under the bell curve to the left of μ-2σ which is .025 . The probability of being further than two standard deviation above the mean is the area under the bell curve to the right of μ+2σ, which is .025 .","key":"pwDpnUr2g8","urlSource":"images/image123.gif"}],"enumerator":"3","key":"MtxBCd2uwt"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/textbook/build/image124-eddcba709670324427d132670da2237c.gif","alt":"A normal bell curve. The probability of being within three standard deviation of μ is .997 . The probability of being below three standard deviations from the mean is the area under the bell curve to the left of μ-3σ which is .0015 . The probability of being further than three standard deviation above the mean is the area under the bell curve to the right of μ+3σ, which is .0015 .","key":"JRRvPwCTOs","urlSource":"images/image124.gif"}],"enumerator":"4","key":"Voy90Z3VTq"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"P3ijQ7NUhC"}],"key":"A2gsnfBSyC"},{"type":"code","lang":"","value":"Suppose that foot length of a randomly chosen adult male is a normal random variable with mean $\\mu=11$ and standard deviation $\\sigma=1.5$. Then the Standard Deviation Rule lets us sketch the probability distribution of X as follows:\n\n```{figure} images/image127.gif\n:alt: A probability distribution curve in which the horizontal axis is labeled \"X - Foot Length.\" The curve is a normal bell curve. The mean, μ, is at X=11. The first standard deviation is at X=9.5 and X=12.5, with probability of .68 . The second standard deviation is X=8 and X=14, with probability of .95 . The third standard deviation is at X=6.5 and X=15.5, with probability of .997 .\n```\n\n*(a)* What is the probability that a randomly chosen adult male will have a foot length between 8 and 14 inches? .95, or 95%.\n\n*(b)* An adult male is almost guaranteed (.997 probability) to have a foot length between what two values? 6.5 and 15.5 inches.\n\n*(c)* The probability is only 2.5% that an adult male will have a foot length greater than how many inches? 14.\n\n```{figure} images/image128.gif\n:alt: The probability distribution curve for foot lengths. The 2nd standard deviation boundaries from the mean have been marked at X=8 and X=14 . The probability of being within 2 standard deviations of the mean is .95, and the probability of being above 2 standard deviations (X > 14) is .025 . The probability of being below the 2nd standard deviation (X < 8) is also .025 .\n```\n\nNow you should try a few. (Use the figure that is just before *part (a)* to help you.)\n\n```{note}\n    **Learn By Doing**\n\n    *(Interactive activity — available in the OLI platform)*\n```","position":{"start":{"line":48,"column":1},"end":{"line":70,"column":1}},"key":"qx0dAhqlOW"}],"key":"mLVg7pEijY"},{"type":"heading","depth":2,"position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"Comment","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"Ioxz9TAcDU"}],"identifier":"comment","label":"Comment","html_id":"comment-1","implicit":true,"key":"lRJBBKzxJJ"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Notice that there are two types of problems we may want to solve: those like ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"xHs5vRn3St"},{"type":"emphasis","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"(a)","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"GoXSbwkT4X"}],"key":"gt3PXrHBLI"},{"type":"text","value":", ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"LvzcIzNlXL"},{"type":"emphasis","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"(d)","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"LIPBZlb5gr"}],"key":"ObasChX1bs"},{"type":"text","value":" and ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"CVzneo5tq9"},{"type":"emphasis","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"(e)","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"ioeNb7TPGT"}],"key":"Z69AC29nPu"},{"type":"text","value":", in which a particular interval of values of a normal random variable is given, and we are asked to find a probability, and those like ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"JLk4JC3uvs"},{"type":"emphasis","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"(b)","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"ePVK2OKn9H"}],"key":"i3WpfQ3TCw"},{"type":"text","value":", ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"SZewh6FVk0"},{"type":"emphasis","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"(c)","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"HF3gXHg448"}],"key":"nt41fSW2cS"},{"type":"text","value":" and ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"M99rHAFsfB"},{"type":"emphasis","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"(f)","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"qZ5h3oBvK0"}],"key":"ZFyQtOcNgc"},{"type":"text","value":", in which a probability is given and we are asked to identify what the normal random variable’s values would be.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"y3zW0s20PE"}],"key":"gzIy9zuAue"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"QtkpZWuBLO"}],"key":"ggABAEUdAt"},{"type":"code","lang":"","value":"**Did I Get This?**\n\n*(Interactive activity — available in the OLI platform)*","position":{"start":{"line":78,"column":1},"end":{"line":80,"column":1}},"key":"mgDytwU32y"}],"key":"NVUSzSaqnN"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[