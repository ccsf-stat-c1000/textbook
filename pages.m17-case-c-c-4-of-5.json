cs><mrow><msub><mi>H</mi><mn>0</mn></msub></mrow><annotation encoding=\"application/x-tex\">H_0</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.08125em;\">H</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0813em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span>","key":"vZbBEPDAT6"},{"type":"text","value":" if the p-value is less than 0.05.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"YElVi57M0u"}],"key":"DUrjkSL86p"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: Drunk Driving and Gender","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"qzfTIS1fme"}],"key":"Dvqb3cgERo"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"A p-value of 0.201 is not small at all. There is no compelling statistical evidence to reject ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"ZrV4ZAQwCc"},{"type":"inlineMath","value":"H_0","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>H</mi><mn>0</mn></msub></mrow><annotation encoding=\"application/x-tex\">H_0</ann