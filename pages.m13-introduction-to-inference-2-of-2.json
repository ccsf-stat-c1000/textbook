e":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"In ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"sJSu5nfSWH"},{"type":"emphasis","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"point estimation","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"jEdMwYAOkk"}],"key":"KN4O6THC1J"},{"type":"text","value":", we estimate an unknown parameter using a ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"a4WQ3wuuoa"},{"type":"emphasis","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"single number","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"X4c5UIro9c"}],"key":"Nfotti2DGh"},{"type":"text","value":" that is calculated from the sample data.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"iAJyUJfLm1"}],"key":"a7dtMBWUz1"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: Point Estimation","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"HhmHMyld6C"}],"key":"MmzA0dhJgz"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Based on sample results, we estimate that p, the proportion of all U.S. adults who are in favor of stricter gun control, is 0.6.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"fxIm7qk44m"}],"key":"POfYuh0DMt"}],"class":"tip","key":"vnuIdyXvV3"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"In ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"OiyLzYTlrb"},{"type":"emphasis","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"interval estimation","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"XDWdQTf3TK"}],"key":"pTN3Qtxp23"},{"type":"text","value":", we estimate an unknown parameter using an ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"tR2xhlb0Vd"},{"type":"emphasis","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"interval of values","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"dpjxVpZeBh"}],"key":"czkhv3bjJE"},{"type":"text","value":" that is likely to contain the true value of that parameter (and state how confident we are that this interval indeed captures the true value of the parameter).","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"OLc8IjiGhG"}],"key":"VIH2437PJC"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: Interval Estimation","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"fI6fZcEZZQ"}],"key":"vBs7WbKQ55"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Based on sample results, we are 95% confident that p, the proportion of U.S. adults who are in favor of stricter gun control, is between 0.57 and 0.63.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"XlqQW8yWUK"}],"key":"wYVhW0v5fJ"}],"class":"tip","key":"jlILyDhWDB"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"In ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"yxdFXyhTXA"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"hypothesis testing","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"DCm3IOnAIx"}],"key":"XiVE5ljDyQ"},{"type":"text","value":", we have some claim about the population, and we check ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"BjUOozSK1h"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"whether or not the data","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"z2hTskZL2H"}],"key":"CWfPwEHjgV"},{"type":"text","value":" obtained from the sample ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"USNQUDJpKc"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"provide evidence against this claim.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"MN0IQG9aOQ"}],"key":"s8MEpD9bBv"}],"key":"r4LEaVHiS3"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: Hypothesis Testing 1","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"dIE5iL4K3A"}],"key":"UZmNAwm7GB"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"It was claimed that among all U.S. adults, about half are in favor of stricter gun control and about half are against it. In a recent poll of a random sample of 1,200 U.S. adults, 60% were in favor of stricter gun control. This data, therefore, provides some evidence against the claim.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"m6NCCaNSxK"}],"key":"ZecL2geQDZ"}],"class":"tip","key":"lrqzMReDFm"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: Hypothesis Testing 2","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"i3C0pn2RVo"}],"key":"UyXYFHgRcA"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"It is claimed that among drivers 18-23 years of age (our population) there is no relationship between drunk driving and gender. A roadside survey collected data from a random sample of 5,000 drivers and recorded their gender and whether they were drunk. The collected data showed roughly the same percent of drunk drivers among males and among females. These data, therefore, do not give us any reason to reject the claim that drunk driving is not related to gender.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"uGhDXfKgtv"}],"key":"p77kfzACg8"}],"class":"tip","key":"qANffS6zYY"},{"type":"heading","depth":2,"position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Did I Get This?","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"XComYi7IX4"}],"identifier":"did-i-get-this","label":"Did I Get This?","html_id":"did-i-get-this","implicit":true,"key":"QhbxXXJnL8"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"In each of the following scenarios, a conclusion is drawn about a population based on the sample results. Select which form of statistical inference the conclusion represents.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"tbRTSrOTjv"}],"key":"cALGUH6KQD"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-abedf03535fddfc26081d8ab58b0b651.mjs","model":{"question":"\"Based on a sample of 150 customers, the average wait time at the clinic is estimated to be 23 minutes.\" Which form of inference is this?","choices":[{"correct":true,"text":"Point estimation","feedback":"Correct! A single number (23 minutes) estimating the population mean is point estimation."},{"correct":false,"text":"Interval estimation","feedback":"Interval estimation would report a range of plausible values along with a confidence level."},{"correct":false,"text":"Hypothesis testing","feedback":"Hypothesis testing would assess evidence against a stated claim."}],"multi":false,"hint":"A single number is used to estimate the parameter.","explanation":""},"key":"nEm1YJW14u"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-abedf03535fddfc26081d8ab58b0b651.mjs","model":{"question":"\"We are 90% confident that between 42% and 48% of city voters support the bond measure.\" Which form of inference is this?","choices":[{"correct":false,"text":"Point estimation","feedback":"Point estimation would give a single number, like 45%."},{"correct":true,"text":"Interval estimation","feedback":"Correct! A range of plausible values with an attached confidence level is interval estimation."},{"correct":false,"text":"Hypothesis testing","feedback":"No claim is being tested here; the goal is to estimate the parameter."}],"multi":false,"hint":"A range of values with a confidence level.","explanation":""},"key":"q48hXwAm9a"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-abedf03535fddfc26081d8ab58b0b651.mjs","model":{"question":"\"The manufacturer claims its batteries last 100 hours on average. Our sample of 50 batteries averaged only 92 hours, providing evidence against the claim.\" Which form of inference is this?","choices":[{"correct":false,"text":"Point estimation","feedback":"The 92-hour average is used here as evidence about a claim, not as the final estimate."},{"correct":false,"text":"Interval estimation","feedback":"No interval or confidence level appears; instead a claim is evaluated."},{"correct":true,"text":"Hypothesis testing","feedback":"Correct! Assessing whether the data provide evidence against a claim about the population is hypothesis testing."}],"multi":false,"hint":"A stated claim is being checked against sample evidence.","explanation":""},"key":"ptCdrkv63x"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"In terms of organization, the Inference unit consists of two main parts: Inference for One Variable and Inference for Relationships between Two Variables. The organization of each of these parts will be discussed further as we proceed through the unit.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"PFadkqD93c"}],"key":"LYjeiX804n"}],"key":"t5z1I5vz1x"}],"key":"bViEWvebGd"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introduction to Inference (1 of 2)","url":"/pages/m13-introduction-to-inference-1-of-2","group":"Section 10: Introduction to Inference"},"next":{"title":"Inference For One Variable","url":"/pages/m13-inference-for-one-variable","group":"Section 10: Introduction to Inference"}}},"domain":"http://localhost:3000"}