{"version":3,"kind":"Article","sha256":"6f434a4086b7301bd5bd63d7ffeb021c095943b810cfc41a7e63f15d9cbc71e6","slug":"pages.m09-probability-rules-3-of-11","location":"/pages/105-m09-probability-rules-3-of-11.md","dependencies":[],"frontmatter":{"title":"Disjoint Events: When Two Things Can’t Both Happen","content_includes_title":false,"authors":[{"nameParsed":{"literal":"City College of San Francisco","given":"City College","non_dropping_particle":"of","family":"San Francisco"},"name":"City College of San Francisco","id":"contributors-myst-generated-uid-0"}],"license":{"content":{"id":"CC-BY-NC-SA-4.0","url":"https://creativecommons.org/licenses/by-nc-sa/4.0/","name":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","CC":true}},"abbreviations":{"ANOVA":"Analysis of Variance","CI":"Confidence Interval","CLT":"Central Limit Theorem","EDA":"Exploratory Data Analysis","IQR":"Interquartile Range","SD":"Standard Deviation","SE":"Standard Error","SRS":"Simple Random Sample","INCREASE":null,"INCREASED":null,"DECREASES":null,"OBSERVED":null,"ROSE":null},"numbering":{"title":{"offset":2}},"thumbnail":"/textbook/build/m09-disjoint-venn-53f4e4adf5804c6e5dd931f149143592.svg","exports":[{"format":"md","filename":"105-m09-probability-rules-3-of-11.md","url":"/textbook/build/105-m09-probability--c359ede5a0e9a8bdac03bcc46ce58f71.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We are now moving to rule 4, which deals with another situation of frequent interest, finding P(A ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IwkoLIC816"},{"type":"emphasis","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"or","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VhyIfPKyko"}],"key":"x03HqBqzlq"},{"type":"text"