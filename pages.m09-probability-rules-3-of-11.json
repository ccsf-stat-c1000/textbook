ey":"EHjs8XI3R5"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"P(A or B) = P(event A occurs or event B occurs or both occur)","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"E7l3EilFNY"}],"key":"R9ghHNbGHm"}],"key":"UzNhpBusfV"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Having said that, it should be noted that there are some cases where it is simply impossible for the two events to both occur at the same time, in which case we don’t have to worry about the possibility that both occur when we try to find P(A or B). The distinction between events that can happen together and those that cannot is an important one.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"swNCLf8Ufg"}],"key":"oOQKDXlMiS"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Here are two examples:","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"OgOOe5LbKb"}],"key":"Zltx6PQj0j"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: Disjoint Events","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"npJKupIC0P"}],"key":"dmn0NREgaa"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Consider the following two events:","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"MOR02Bt7HF"}],"key":"AtcrLLCo1t"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":24,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"