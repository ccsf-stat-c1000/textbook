xt","value":"Note","key":"YYfAC2zKsl"}],"key":"dIFgRRPfvF"},{"type":"code","lang":"","value":"**Many Students Wonder**\n\nOverview\n\n*(Interactive activity — available in the OLI platform)*","position":{"start":{"line":91,"column":1},"end":{"line":95,"column":1}},"key":"z9XP69QGdM"}],"key":"D61cb9xisN"}],"key":"bhVVsISsUE"}],"key":"md10xQAzOO"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Examining Relationships","url":"/pages/m05-examining-relationships","group":"Module 5: Examining Relationships"},"next":{"title":"The Role-Type Classification (2 of 2)","url":"/pages/m05-the-role-type-classification-2-of-2","group":"Module 5: Examining Relationships"}}},"domain":"http://localhost:3000"}