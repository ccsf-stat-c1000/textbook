fdade.mjs","model":{"question":"Is the normal approximation appropriate for a binomial random variable with n = 100 and p = 0.05?","choices":[{"correct":false,"text":"Yes—both conditions hold","feedback":"np = 100(0.05) = 5, which is less than 10—the rule of thumb fails."},{"correct":true,"text":"No—np = 5 is less than 10","feedback":"Correct! np = 5 < 10, so the approximation is not appropriate; the distribution is still too skewed right."},{"correct":false,"text":"No—n(1 − p) is less than 10","feedback":"n(1 − p) = 95 is fine, but BOTH conditions must hold, and np = 5 fails."}],"multi":false,"hint":"Check np and n(1 − p) against 10.","explanation":""},"key":"Bz8vvcS5uE"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-a12b495d51e99bfc7862c0d02cefdade.mjs","model":{"question":"Is the normal approximation appropriate for a binomial random variable with n = 400 and p = 0.1?","choices":[{"correct":true,"text":"Yes—np = 40 and n(1 − p) = 360 both exceed 10","feedback":"Correct! np = 40 ≥ 10 and n(1 − p) = 360 ≥ 10, so the approximation is appropriate."},{"correct":false,"text":"No—p = 0.1 is too small for any n","feedback":"Check the arithmetic: np = 400(0.1) = 40, which satisfies the condition."}],"multi":false,"hint":"np = 40 and n(1 − p) = 360.","explanation":""},"key":"MPUztqOM2U"}],"key":"aATXKzk23U"}],"key":"JjSITPKoY2"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Why Approximate the Binomial with a Normal?","url":"/pages/m11-normal-approximation-to-the-binomial-1-of-3","group":"Section 8: Random Variables"},"next":{"title":"The Continuity Correction","url":"/pages/m11-normal-approximation-to-the-binomial-3-of-3","group":"Section 8: Random Variables"}}},"domain":"http://localhost:3000"}