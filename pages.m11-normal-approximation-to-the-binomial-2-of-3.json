onditions must hold, and np = 5 fails."}],"multi":false,"hint":"Check np and n(1 - p) against 10.","explanation":""},"key":"Waa9IFKyMb"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-0e29ae0bec3a8408692689b04ac6d4d1.mjs","model":{"question":"Is the normal approximation appropriate for a binomial random variable with $n = 400$ and $p = 0.1$?","choices":[{"correct":true,"text":"Yes—np = 40 and n(1 - p) = 360 both exceed 10","feedback":"Correct! np = $40 \\geq 10$ and n(1 - p) = $360 \\geq 10$, so the approximation is appropriate."},{"correct":false,"text":"No—p = 0.1 is too small for any n","feedback":"Check the arithmetic: np = $400(0.1) = 40$, which satisfies the condition."}],"multi":false,"hint":"np = 40 and n(1 - p) = 360.","explanation":""},"key":"aJLqe0czXn"}],"key":"xDlOb0QqkV"}],"key":"YaGcnXRuMS"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Why Approximate the Binomial with a Normal?","url":"/pages/m11-normal-approximation-to-the-binomial-1-of-3","group":"Section 8: Random Variables"},"next":{"title":"The Continuity Correction","url":"/pages/m11-normal-approximation-to-the-binomial-3-of-3","group":"Section 8: Random Variables"}}},"domain":"http://localhost:3000"}