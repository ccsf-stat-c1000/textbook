{"version":3,"kind":"Article","sha256":"1ed969eccababb83154a1d15528a46ee1665400b7b2d936e41992fa32be7ef54","slug":"pages.m10-the-general-multiplication-rule-2-of-2","location":"/pages/122-m10-the-general-multiplication-rule-2-of-2.md","dependencies":[],"frontmatter":{"title":"The General Multiplication Rule in Action","content_includes_title":false,"authors":[{"nameParsed":{"literal":"City College of San Francisco","given":"City College","non_dropping_particle":"of","family":"San Francisco"},"name":"City College of San Francisco","id":"contributors-myst-generated-uid-0"}],"license":{"content":{"id":"CC-BY-NC-SA-4.0","url":"https://creativecommons.org/licenses/by-nc-sa/4.0/","name":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","CC":true}},"numbering":{"title":{"offset":2}},"exports":[{"format":"md","filename":"122-m10-the-general-multiplication-rule-2-of-2.md","url":"/textbook/build/122-m10-the-general--ce29b9e2b8b5300c32a61d89a06fc1f1.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Learning Objectives","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HZn2Mf4O64"}],"key":"HvKT6CiP4U"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Use the General Multiplication Rule to find the probability that two events occur (P(A and B)).","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"aX0CblZa5B"}],"key":"GrW3qkIWLS"}],"key":"d1wXXye8tR"}],"key":"iTjWtgxmpT"}],"class":"note","key":"afVYS1sV0q"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Here, again, is the General Multiplication Rule:","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"o48sXkx7zF"}],"key":"VkxlOhCjyv"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"For any two events A and B, P(A and B) = P(A) × P(B | A)","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"YkjzCCl7SE"}],"key":"FIYlDpHnfb"}],"key":"Yg6j5oa9Z1"},{"type":"heading","depth":2,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Comments","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"UqEidGdknl"}],"identifier":"comments","label":"Comments","html_id":"comments","implicit":true,"key":"z6cwF40Brs"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":15,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Note that although the motivation for this rule was to find P(A and B) when A and B are not independent, this rule is general in the sense that if A and B happen to be ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"W1bSVT2DqV"},{"type":"emphasis","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"independent","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"AxKpN4Xcnt"}],"key":"BlI9FQ0fyy"},{"type":"text","value":", then P(B | A) = P(B) is true, and we’re back to Rule 5—the Multiplication Rule for Independent Events: P(A and B) = P(A) × P(B).","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"D5BnYFEqGf"}],"key":"rDIsoNMpGx"}],"key":"OCCHIXnW6G"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"The General Multiplication Rule is just the definition of conditional probability in disguise. Recall the definition of conditional probability: ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"p60LgIt53D"},{"type":"emphasis","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"P(B | A) = P(A and B) / P(A)","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"cJCygJhaub"}],"key":"Zrzt3wcnHj"},{"type":"text","value":". Let’s isolate P(A and B) by multiplying both sides of the equation by P(A), and we get: ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"r7QDf47gt9"},{"type":"emphasis","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"P(A and B) = P(A) × P(B | A)","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"JbGcDRdlZK"}],"key":"miZcSsSxN7"},{"type":"text","value":". That’s it ... this is the General Multiplication Rule.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"QQRfsjFtv8"}],"key":"YGEVS2JhUO"}],"key":"dxyK2Mx1bl"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"The General Multiplication Rule is useful when two events, A and B, occur in stages, first A and then B (like the selection of the two cards in the previous example). Thinking about it this way makes the General Multiplication Rule very intuitive. For both A and B to occur you first need A to occur (which happens with probability P(A)), ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"TTACiR1eJ5"},{"type":"emphasis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"and","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"U7aImkcwZl"}],"key":"bAm4dppkQF"},{"type":"text","value":" then you need B to occur, knowing that A has already occurred (which happens with probability P(B | A)).","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"mK0O8rLvJN"}],"key":"qEkDicVROv"}],"key":"qsNr71ASd4"}],"key":"Ulnsu5KAJg"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Let’s look at another, more realistic example:","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"glarhwkwMd"}],"key":"vptd1rEJc1"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: HIV Testing","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"ky9dWUID2B"}],"key":"D4qy8jbhc0"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"In a certain region, one in every thousand people (0.001) of all individuals is infected by the HIV virus that causes AIDS. Tests for presence of the virus are fairly accurate but not perfect. If someone actually has HIV, the probability of testing positive is 0.95. Let ","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"RR5aUkT5dG"},{"type":"emphasis","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"H","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"arPILJqdZE"}],"key":"lLZodF4hzA"},{"type":"text","value":" denote the event of having HIV, and ","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"vw46LCB2bR"},{"type":"emphasis","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"T","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"mDkgTv8UEO"}],"key":"it3s4IH1iC"},{"type":"text","value":" the event of testing positive.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"IetugRNQ2Z"}],"key":"LWSLhecEPY"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"(a) Express the information that is given in the problem in terms of the events H and T.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"U0Enu3ghfD"}],"key":"cu4sZvE9BM"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"“one in every thousand people (0.001) of all individuals are infected with HIV” → ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"WvDbfrYsoU"},{"type":"emphasis","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"P(H) = 0.001","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"DW3N0L0jhz"}],"key":"GoYvnvTKSm"}],"key":"YBGueF4nUI"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"“If someone actually has HIV, the probability of testing positive is 0.95” → ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"ZPZaNQ83dg"},{"type":"emphasis","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"P(T | H) = 0.95","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"FLh8LHTryj"}],"key":"lbmFbh6Bp8"}],"key":"qhOjPgepuP"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"(b) Use the General Multiplication Rule to find the probability that someone chosen at random from the population has HIV and tests positive.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"sekDmCHU9y"}],"key":"gMM1YPS43D"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"P(H and T)","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"BS4yn0P84s"}],"key":"oRkL8TyQK3"},{"type":"text","value":" = P(H) × P(T | H) = 0.001 × 0.95 = 0.00095.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"lnV5Y2GCZZ"}],"key":"mwwJ9i5uHg"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"(c) If someone has HIV, what is the probability of testing negative? Here we need to find P(not T | H).","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"i9CxreCZDy"}],"key":"ggfCkoyGLZ"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Recall from an activity earlier in this module that the Complement Rule works with conditional probabilities as long as we condition on the same event, therefore: ","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"UHDQrTdCNp"},{"type":"emphasis","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"P(not T | H)","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"mLglma6MEP"}],"key":"eWOH0for4l"},{"type":"text","value":" = 1 − P(T | H) = 1 − 0.95 = 0.05.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"TF5mAOHLAz"}],"key":"g9IHORVOCn"}],"class":"tip","key":"u2dzaNFMZT"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"The purpose of the next activity is to give you guided practice in expressing information in terms of conditional probabilities, and in using the General Multiplication Rule.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"tYZmkogWIz"}],"key":"LdyQB69psm"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Learn By Doing","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"oXYzGOPeT6"}],"identifier":"learn-by-doing","label":"Learn By Doing","html_id":"learn-by-doing","implicit":true,"key":"OXRSGbvWf2"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"An overheating engine can quickly cause serious damage to a car, and therefore a dashboard red warning light is supposed to come on if that happens.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"V1DMuqe6ZM"}],"key":"X5Vg3oX3pa"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"In a certain model car, there is a 3% chance that the engine will overheat (event H).","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"VIeWDVoOe0"}],"key":"A8m4MVI1zV"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"The probability of the warning light showing up (event W) when it should (i.e., when the engine is really overheating) is 0.98. However, 1% of the time the warning light appears for no apparent reason (i.e., when the engine temperature is normal).","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"OTfIPC4c5X"}],"key":"gDlpmJj1SM"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-e9689e083a3d48b3e46875a14efdf8d0.mjs","model":{"question":"How should the sentence \"the probability of the warning light showing up when the engine is really overheating is 0.98\" be written in probability notation?","choices":[{"correct":true,"text":"P(W | H) = 0.98","feedback":"Correct! Given that the engine overheats (H), the light comes on with probability 0.98: P(W | H) = 0.98."},{"correct":false,"text":"P(H | W) = 0.98","feedback":"P(H | W) would be the probability of overheating given that the light is on—the reverse of what's stated."},{"correct":false,"text":"P(W and H) = 0.98","feedback":"P(W and H) is the probability that both happen, which is not what the sentence describes."}],"multi":false,"hint":"The overheating is the given (conditioning) event.","explanation":""},"key":"CCu0YIEcuL"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-e9689e083a3d48b3e46875a14efdf8d0.mjs","model":{"question":"How should \"1% of the time the warning light appears for no apparent reason (when the engine temperature is normal)\" be written?","choices":[{"correct":true,"text":"P(W | not H) = 0.01","feedback":"Correct! Given no overheating (not H), the light appears with probability 0.01: P(W | not H) = 0.01."},{"correct":false,"text":"P(not H | W) = 0.01","feedback":"P(not H | W) reverses the conditioning."},{"correct":false,"text":"P(W) = 0.01","feedback":"P(W) = 0.01 would be the overall probability of the light, ignoring the engine's state."}],"multi":false,"hint":"The condition here is that the engine is NOT overheating.","explanation":""},"key":"xmoE8ZrUzg"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-e9689e083a3d48b3e46875a14efdf8d0.mjs","model":{"question":"What is the probability that the engine overheats AND the warning light comes on?","choices":[{"correct":true,"text":"0.0294","feedback":"Correct! P(H and W) = 0.03 × 0.98 = 0.0294."},{"correct":false,"text":"0.98","feedback":"0.98 is the conditional probability of the light given overheating, not the joint probability."},{"correct":false,"text":"0.0003","feedback":"0.0003 uses the false-alarm rate; the light-given-overheating probability is 0.98."}],"multi":false,"hint":"Use the General Multiplication Rule: P(H and W) = P(H) × P(W | H).","explanation":""},"key":"cn5bO6Waa8"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-e9689e083a3d48b3e46875a14efdf8d0.mjs","model":{"question":"What is the probability that the engine is fine AND the warning light comes on anyway (a false alarm)?","choices":[{"correct":true,"text":"0.0097","feedback":"Correct! P(not H and W) = 0.97 × 0.01 = 0.0097."},{"correct":false,"text":"0.01","feedback":"0.01 is the conditional false-alarm rate; multiply by P(not H) to get the joint probability."},{"correct":false,"text":"0.03","feedback":"0.03 is P(H); the false alarm involves \"not H.\""}],"multi":false,"hint":"P(not H) = 0.97 and P(W | not H) = 0.01.","explanation":""},"key":"LsP5Ykdx92"}],"key":"riuGwjyq6R"}],"key":"RSNY6EUrPI"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"The General Multiplication Rule: P(A and B) Without Independence","url":"/pages/m10-the-general-multiplication-rule-1-of-2","group":"Section 7: Conditional Probability and Independence"},"next":{"title":"Probability Trees: Mapping Multi-Stage Problems","url":"/pages/m10-probability-trees-1-of-3","group":"Section 7: Conditional Probability and Independence"}}},"domain":"http://localhost:3000"}