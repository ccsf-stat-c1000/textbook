"accent-body\" style=\"left:-0.1667em;\"><span class=\"mord\">ˉ</span></span></span></span></span></span></span></span></span></span>","key":"VcJqdqE6qZ"},{"type":"text","value":", the sample mean, relative to the parameter ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"l1Q1oSnBwT"},{"type":"inlineMath","value":"\\mu","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>μ</mi></mrow><annotation encoding=\"application/x-tex\">\\mu</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">μ</span></span></span></span>","key":"d4sGJKHQsS"},{"type":"text","value":", the population mean (when the variable of interest is quantitative).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jmGnlaAtex"}],"key":"YeZrJF7XzO"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Behavior of Sample Mean (x-bar)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"diSHne0Foc"}],"identifier":"behavior-of-sample-mean-x-bar","label":"Behavior of Sample Mean (x-bar)","html_id":"behavior-of-sample-mean-x-bar","implicit":true,"key":"NZM2DB9yCL"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: Birth Weights","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"zbkqNvok9w"}],"key":"vrVl4nEUMm"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Birth weights are recorded for all babies in a town. The mean birth weight is 3,500 grams, ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"E36aZBPxEA"},{"type":"inlineMath","value":"\\mu = 3{,}500","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>μ</mi><mo>=</mo><mn>3</mn><mo separator=\"true\" lspace=\"0em\" rspace=\"0em\">,</mo><mn>500</mn></mrow><annotation encoding=\"application/x-tex\">\\mu = 3{,}500</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">μ</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8389em;vertical-align:-0.1944em;\"></span><span class=\"mord\">3</span><span class=\"mord\"><span class=\"mpunct\">,</span></span><span class=\"mord\">500</span></span></span></span>","key":"EGB2LEnrQ5"},{"type":"text","value":" g. If we collect many random samples of 9 babies at a time, how do you think sample means will behave?","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"fUKMGay5uP"}],"key":"LRaSSiXnfb"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Here again, we are working with a random variable, since random samples will have means that vary unpredictably in the short run but exhibit patterns in the long run.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"yzCYs0kbmA"}],"key":"P8hRrpKXhV"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Based on our intuition and what we have learned about the behavior of sample proportions, we might expect the following about the distribution of sample means:","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"Qgx7ILQBgL"}],"key":"VaHrnmW8yF"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"crossReference","label":"center","identifier":"term-center","children":[{"type":"text","value":"Center","key":"T9asQf48g2"}],"kind":"definitionTerm","template":"{name}","resolved":true,"html_id":"term-center","remote":true,"url":"/pages/glossary","dataUrl":"/pages.glossary.json","key":"EY2e8OtD9S"},{"type":"text","value":": Some sample means will be on the low side—say 3,000 grams or so—while others will be on the high side—say 4,000 grams or so. In repeated sampling, we might expect that the random samples will average out to the underlying population mean of 3,500 g. In other words, the mean of the sample means will be ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"jD4mVGMxG9"},{"type":"inlineMath","value":"\\mu","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>μ</mi></mrow><annotation encoding=\"application/x-tex\">\\mu</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">μ</span></span></span></span>","key":"VzguAprx2H"},{"type":"text","value":", just as the mean of sample proportions was p.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"VjjInT80ii"}],"key":"V2H202a2DA"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"crossReference","label":"spread","identifier":"term-spread","children":[{"type":"text","value":"Spread","key":"JrGpfgnr4T"}],"kind":"definitionTerm","template":"{name}","resolved":true,"html_id":"term-spread","remote":true,"url":"/pages/glossary","dataUrl":"/pages.glossary.json","key":"pknt4O7Lmv"},{"type":"text","value":": For large samples, we might expect that sample means will not stray too far from the population mean of 3,500. Sample means lower than 3,000 or higher than 4,000 might be surprising. For smaller samples, we would be less surprised by sample means that varied quite a bit from 3,500. In other words, we might expect greater variability in sample means for smaller samples. So sample size will again play a role in the spread of the distribution of sample means, as we observed for sample proportions.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"sVkIYyw9J7"}],"key":"t9p9ba12mQ"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"crossReference","label":"shape","identifier":"term-shape","children":[{"type":"text","value":"Shape","key":"KVNZAq2nRe"}],"kind":"definitionTerm","template":"{name}","resolved":true,"html_id":"term-shape","remote":true,"url":"/pages/glossary","dataUrl":"/pages.glossary.json","key":"A0eW0I1t60"},{"type":"text","value":": Sample means closest to 3,500 will be the most common, with sample means far from 3,500 in either direction progressively less likely. In other words, the shape of the distribution of sample means should bulge in the middle and taper at the ends with a shape that is somewhat normal. This, again, is what we saw when we looked at the sample proportions.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"ejVGzbkIYw"}],"key":"jUEUKjw2Oq"}],"class":"tip","key":"TNUY5zcVY4"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Comment","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"h4q2H95Xh3"}],"key":"NROGiU4rzC"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ZdoEkT1djZ"},{"type":"crossReference","label":"distribution","identifier":"term-distribution","children":[{"type":"text","value":"distribution","key":"pcNKZ0rq4K"}],"kind":"definitionTerm","template":"{name}","resolved":true,"html_id":"term-distribution","remote":true,"url":"/pages/glossary","dataUrl":"/pages.glossary.json","key":"tpBMrWLC3t"},{"type":"text","value":" of the values of the sample mean (","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"tdodHb5W1u"},{"type":"inlineMath","value":"\\bar{x}","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mover accent=\"true\"><mi>x</mi><mo>ˉ</mo></mover></mrow><annotation encoding=\"application/x-tex\">\\bar{x}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.5678em;\"></span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.5678em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord mathnormal\">x</span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.2222em;\"><span class=\"mord\">ˉ</span></span></span></span></span></span></span></span></span></span>","key":"jHSqa7rhRV"},{"type":"text","value":") in repeated ","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"dHob459nCA"},{"type":"crossReference","label":"sample","identifier":"term-sample","children":[{"type":"text","value":"samples","key":"WoQ9Nof4kK"}],"kind":"def