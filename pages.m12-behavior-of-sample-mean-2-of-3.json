94,-422s-65,47,-65,47z\nM834 80h400000v40h-400000z'/></svg></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2341em;\"><span></span></span></span></span></span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.394em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.03588em;\">σ</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.538em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span></span>","key":"lnQZtfioFw"}],"key":"wa8q2Lmihd"},{"type":"tableCell","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"When will it be approximately normal?","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"qdLN6Goyp9"}],"key":"qIDR56pnwt"}],"key":"zIFPVv7fZN"}],"key":"jlk761QBaQ"}],"key":"Dai8JRnTaf"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Now we will investigate the shape of the sampling distribution of sample means. When we were discussing the sampling distribution of sample proportions, we said that this distribution is approximately normal if np ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"KJhAWWH7qt"},{"type":"inlineMath","value":"\\geq 10","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>≥</mo><mn>10</mn></mrow><annotation encoding=\"application/x-tex\">\\geq 10</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7719em;vertical-align:-0.136em;\"></span><span class=\"mrel\">≥</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">10</span></span></span></span>","key":"E4c7npARCd"},{"type":"text","value":" and n(1 - p) ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"R0BkugeuiO"},{"type":"inlineMath","value":"\\geq 10","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>≥</mo><mn>10</mn></mrow><annotation encoding=\"application/x-tex\">\\geq 10</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7719em;vertical-align:-0.136em;\"></span><span class=\"mrel\">≥</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">10</span></span></span></span>","key":"HbO7dFwHiJ"},{"type":"text","value":". In other words, we had a guideline based on sample size for determining the conditions under which we could use normal probability calculations for sample proportions.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"jtTq1Zoviw"}],"key":"Co0ppuj1Au"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"When will the distribution of sample means be approximately normal? Does this depend on the size of the sample?","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"E0r93Pmq9I"}],"key":"cH0LBlJxzK"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"It seems reasonable that a population with a normal distribution will have sample means that are normally distributed even for very small samples. We saw this illustrated in the previous simulation with samples of size 9.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"zV89VTyLbL"}],"key":"qLSeMUeowM"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"What happens if the distribution of the variable in the population is heavily skewed? Do sample means have a skewed distribution also? If we take really large samples, will the sample means become more normally distributed?","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"BvErhKDC1s"}],"key":"vGOtfJiQHT"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"In the next simulation video, we investigate these questions:","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"yh9mVgOgMx"}],"key":"cCCSV96Snm"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Video","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"GsVbGenS13"}],"key":"FHJWEMY0Zr"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"link","url":"https://www.youtube.com/watch?v=cyNqdostWzk","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"Behavior of Sample Mean 2","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"B7siaHpElO"}],"urlSource":"https://www.youtube.com/watch?v=cyNqdostWzk","key":"Q1N4QX3QL2"}],"key":"UKQuGYnoVA"}],"key":"pR35MG6w7T"},{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"To summarize, the distribution of sample means will be approximately normal as long as the sample size is large enough. This discovery is probably the single most important result presented in introductory statistics courses. It is stated formally as the ","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"cxQ23IBFDJ"},{"type":"crossReference","label":"central limit theorem","identifier":"term-central limit theorem","children":[{"type":"text","value":"Central Limit Theorem","key":"dqLCLR5n3b"}],"kind":"definitionTerm","template":"{name}","resolved":true,"html_id":"term-central-limit-theorem","remote":true,"url":"/pages/glossary","dataUrl":"/pages.glossary.json","key":"nzmb1GbnhW"},{"type":"text","value":".","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"z8PsYQYRQG"}],"key":"DOATHGRI5m"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"We will depend on the Central Limit Theorem again and again in order to do normal probability calculations when we use sample means to draw conclusions about a population mean. We now know that we can do this even if the population distribution is not normal.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"KGrEIbTTe3"}],"key":"w0Geb9uTvy"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"How large a sample size do we need in order to assume that sample means will be normally distributed? Well, it really depends on the population distribution, as we saw in the simulation. The general rule of thumb is that samples of size 30 or greater will have a fairly normal distribution regardless of the shape of the distribution of the variable in the population.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"epNUKoIHal"}],"key":"x9JowNt3S6"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"Comment:","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"EeXtBcDg28"}],"key":"sKRdRWcqkF"},{"type":"text","value":" For categorical variables, our claim that sample proportions are approximately normal for large enough n is actually a special case of the Central Limit Theorem.","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"AqfFODY8e6"}],"key":"KaIUL3lGBx"},{"type":"heading","depth":2,"position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"Check Your Understanding: The Central Limit Theorem","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"FbgDFAFs0Q"}],"identifier":"check-your-understanding-the-central-limit-theorem","label":"Check Your Understanding: The Central Limit Theorem","html_id":"check-your-understanding-the-central-limit-theorem","implicit":true,"key":"uwd81LiBeo"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-46473626c2d422416f7e5797e78ceb60.mjs","model":{"question":"Household incomes in a city are strongly skewed right. If we take random samples of 100 households and compute the mean income of each sample, what shape will the distribution of these sample means have?","choices":[{"correct":true,"text":"Approximately normal","feedback":"Correct! By the Central Limit Theorem, with $n = 100$ the sample means are approximately normal even though the population is skewed."},{"correct":false,"text":"Skewed right, like the population","feedback":"The skewness of the population does NOT carry over to the sample means when n is large—that's the magic of the CLT."},{"correct":false,"text":"Unpredictable","feedback":"The shape is predictable: approximately normal, centered at $\\mu$, with SD $\\sigma/\\sqrt{100}$."}],"multi":false,"hint":"Apply the Central Limit Theorem: $n = 100$ is well above 30.","explanation":""},"key":"EoVlG1yoBX"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-46473626c2d422416f7e5797e78ceb60.mjs","model":{"question":"A population is exactly normal. How large must samples be for the sampling distribution of the sample mean to be normal?","choices":[{"correct":true,"text":"Any sample size—the sample mean is normal even for tiny samples","feedback":"Correct! If the population itself is normal, the sample mean is exactly normal for ANY sample size, even $n = 2$."},{"correct":false,"text":"At least 30, as always","feedback":"The $n \\geq 30$ rule of thumb is only needed when the population is NOT normal."}],"multi":false,"hint":"What did the simulation with samples of size 9 show?","explanation":""},"key":"TXKTHeOLTU"}],"key":"kMZJqnSOtv"}],"key":"R83McT7IgP"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"The Sample Mean: Center, Spread, and Shape","url":"/pages/m12-behavior-of-sample-mean-1-of-3","group":"Section 9: Sampling Distributions"},"next":{"title":"Applying the Central Limit Theorem","url":"/pages/m12-behavior-of-sample-mean-3-of-3","group":"Section 9: Sampling Distributions"}}},"domain":"http://localhost:3000"}