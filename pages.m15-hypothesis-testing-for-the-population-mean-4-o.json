en":[{"type":"text","value":"Check Your Understanding: Sample Size and Conclusions","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"wg612JCrni"}],"identifier":"check-your-understanding-sample-size-and-conclusions","label":"Check Your Understanding: Sample Size and Conclusions","html_id":"check-your-understanding-sample-size-and-conclusions","implicit":true,"key":"ADhIeZBj2e"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Let’s revisit example 1 and see what a larger sample would have done. Suppose the dean had sampled 25 students (instead of 4) and again found a sample mean SAT-M of 550.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"lI2H0OJ4Ee"}],"key":"BLVP1U2VdX"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-5ab7741f068f0c911cebb1163aadce93.mjs","model":{"question":"With $n = 25$ and the same sample mean of 550, what is the test statistic?","choices":[{"correct":true,"text":"$z = 2.5$","feedback":"Correct! The standard error shrinks to $100/\\sqrt{25} = 20$, so $z = 50/20 = 2.5$."},{"correct":false,"text":"$z = 1$","feedback":"$z = 1$ was the value for $n = 4$; with $n = 25$ the standard error is smaller, so z is larger."},{"correct":false,"text":"$z = 0.5$","feedback":"Remember to divide $\\sigma$ by $\\sqrt{n}$: $100/\\sqrt{25} = 20$."}],"multi":false,"hint":"$z = (550 - 500)/(100/\\sqrt{25})$.","explanation":""},"key":"pykgtItYSK"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-5ab7741f068f0c911cebb1163aadce93.mjs","model":{"question":"The p-value for $z = 2.5$ (one-sided) is about 0.006. What do we conclude now, and what is the lesson?","choices":[{"correct":true,"text":"Reject $H_0—the$ same sample mean of 550 becomes convincing evidence when based on 25 students instead of 4","feedback":"Correct! With $0.006 < 0.05$ we now reject $H_0$. The same sample mean carries far more weight when it comes from a larger sample."},{"correct":false,"text":"Do not reject $H_0—the$ results are still not significant","feedback":"0.006 is much smaller than 0.05, so the results ARE significant."},{"correct":false,"text":"The conclusion is unrelated to the sample size","feedback":"The data did not change in direction—the increased sample size is what strengthened the evidence."}],"multi":false,"hint":"Compare with the $n = 4$ case, where the same sample mean gave a p-value of 0.159.","explanation":""},"key":"n5TYvZCWQU"}],"key":"pQ5aYQREIJ"}],"key":"KMB4GdZc5b"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Step 3: Finding the P-value for a Mean","url":"/pages/m15-hypothesis-testing-for-the-population-mean-3-o","group":"Section 12: Hypothesis Testing"},"next":{"title":"Tests and Confidence Intervals for a Mean","url":"/pages/m15-hypothesis-testing-for-the-population-mean-5-o","group":"Section 12: Hypothesis Testing"}}},"domain":"http://localhost:3000"}