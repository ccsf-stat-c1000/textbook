":1},"end":{"line":31,"column":1}},"key":"jjsFBf3mF2"}],"key":"peoYXw6iTJ"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-bd460dc0b54ae3b92420be90a212d5e2.mjs","model":{"question":"With n = 25 and the same sample mean of 550, what is the test statistic?","choices":[{"correct":true,"text":"z = 2.5","feedback":"Correct! The standard error shrinks to 100/√25 = 20, so z = 50/20 = 2.5."},{"correct":false,"text":"z = 1","feedback":"z = 1 was the value for n = 4; with n = 25 the standard error is smaller, so z is larger."},{"correct":false,"text":"z = 0.5","feedback":"Remember to divide σ by √n: 100/√25 = 20."}],"multi":false,"hint":"z = (550 − 500)/(100/√25).","explanation":""},"key":"Z7GoQ7hrOw"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-bd460dc0b54ae3b92420be90a212d5e2.mjs","model":{"question":"The p-value for z = 2.5 (one-sided) is about 0.006. What do we conclude now, and what is the lesson?","choices":[{"correct":true,"text":"Reject H₀—the same sample mean of 550 becomes convincing evidence when based on 25 students instead of 4","feedback":"Correct! With 0.006 < 0.05 we now reject H₀. The same sample mean carries far more weight when it comes from a larger sample."},{"correct":false,"text":"Do not reject H₀—the results are still not significant","feedback":"0.006 is much smaller than 0.05, so the results ARE significant."},{"correct":false,"text":"The conclusion is unrelated to the sample size","feedback":"The data did not change in direction—the increased sample size is what strengthened the evidence."}],"multi":false,"hint":"Compare with the n = 4 case, where the same sample mean gave a p-value of 0.159.","explanation":""},"key":"UzbEMWQNAy"}],"key":"xAFtu87gxY"}],"key":"SVfzvUqHEP"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Step 3: Finding the P-value for a Mean","url":"/pages/m15-hypothesis-testing-for-the-population-mean-3-o","group":"Section 12: Hypothesis Testing"},"next":{"title":"Tests and Confidence Intervals for a Mean","url":"/pages/m15-hypothesis-testing-for-the-population-mean-5-o","group":"Section 12: Hypothesis Testing"}}},"domain":"http://localhost:3000"}