{"version":3,"kind":"Article","sha256":"989eeed1260d6fd50d93a92adc0bd0d2734ee66e7258643143f1cc853a20a78c","slug":"pages.p141-m11-rules-for-means-and-variances-of-random-v","location":"/pages/p141-m11-rules-for-means-and-variances-of-random-variables-1-of.md","dependencies":[],"frontmatter":{"title":"Shifting and Scaling a Random Variable","content_includes_title":false,"authors":[{"nameParsed":{"literal":"City College of San Francisco","given":"City College","non_dropping_particle":"of","family":"San Francisco"},"name":"City College of San Francisco","id":"contributors-myst-generated-uid-0"}],"license":{"content":{"id":"CC-BY-NC-SA-4.0","url":"https://creativecommons.org/licenses/by-nc-sa/4.0/","name":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","CC":true}},"numbering":{"title":{"enabled":true,"offset":0,"enumerator":"%s."}},"abbreviations":{"ANOVA":"Analysis of Variance","CI":"Confidence Interval","CLT":"Central Limit Theorem","EDA":"Exploratory Data Analysis","IQR":"Interquartile Range","SD":"Standard Deviation","SE":"Standard Error","SRS":"Simple Random Sample","INCREASE":null,"INCREASED":null,"DECREASES":null,"OBSERVED":null,"ROSE":null},"enumerator":"125.","thumbnail":"/textbook/build/m11-shift-hist-fe8270a71ca96326b03f53a69b13b447.svg","exports":[{"format":"md","filename":"p141-m11-rules-for-means-and-variances-of-random-variables-1-of.md","url":"/textbook/build/p141-m11-rules-for-m-df097372b31bf19596bea7feee56b91e.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Rules for Means and Variances of Random Variables","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LGYviHuxrh"}],"identifier":"rules-for-means-and-variances-of-random-variables","label":"Rules for Means and Variances of Random Variables","html_id":"rules-for-means-and-variances-of-random-variables","implicit":true,"key":"VvsX9AqU1E"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"So far we’ve learned how to calculate the mean and standard deviation of a random variable, and how to interpret these numerical measures. Let’s look at a motivating example that will show us what kinds of situations we may find these rules useful in.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"UB9AiznIMP"}],"key":"iFMnrNd5Ev"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: Xavier’s Production Line","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"lYWbGXTSgv"}],"key":"TPm1MYId8V"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Assume that operating Xavier’s production line costs $50 per hour, and that the repair cost of one defective part is $5. If X is the number of defective parts produced per hour, then the hourly cost would be ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"dACdeT9iO7"},{"type":"emphasis","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"50 + 5X","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"CJx4eVhGnC"}],"key":"FxuCIqkltE"},{"type":"text","value":". Note that since X is a random variable, so is the cost, 50 + 5X, and we might be interested in the mean and standard deviation of the hourly cost of operation for Xavier’s production line.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"ZZvBx0BrUE"}],"key":"uLje8GKy39"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"If we know the mean and standard deviation for the number of defective parts 