/mn></mrow><annotation encoding=\"application/x-tex\">2) = 0.1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">2</span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.1</span></span></span></span>","key":"GsrngqaVsE"},{"type":"text","value":". It can easily be shown that X has a mean of 0, and a standard deviation of 1.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"qDSy7ZK8d6"}],"key":"vAigl8BpHI"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Adding or Subtracting a Constant","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"qTzXuss3tD"}],"identifier":"adding-or-subtracting-a-constant","label":"Adding or Subtracting a Constant","html_id":"adding-or-subtracting-a-constant","implicit":true,"key":"fZlsKd4MDG"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"What would the mean and standard deviation be if we shifted the entire histogram over 6 units to the right—in other words, what are the mean and standard deviation of ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"IOQchdjUK0"},{"type":"inlineMath","value":"X + 6","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>X</mi><mo>+</mo><mn>6</mn></mrow><annotation encoding=\"application/x-tex\">X + 6</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7667em;vertical-align:-0.0833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.07847em;\">X</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">6</span></span></span></span>","key":"RwBsJHI60Y"},{"type":"text","value":"? And what if we shifted it 7 units to the left, to get ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"OOUquIXDQt"},{"type":"inlineMath","value":"X - 7","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>X</mi><mo>−</mo><mn>7</mn></mrow><annotation encoding=\"application/x-tex\">X - 7</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7667em;vertical-align:-0.0833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.07847em;\">X</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">7</span></span></span></span>","key":"ulDbXO8nb8"},{"type":"text","value":"?","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"cfwSzAkELm"}],"key":"ahftDIIjmG"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/textbook/build/m11-shift-hist-95ca4d8dd5bf6a34743ea122fe247ec8.svg","alt":"Three identical-shaped probability histograms. The original X is centered at 0. X plus 6 is the same shape shifted so it is centered at 6, and X minus 7 is the same shape centered at negative 7. In all three the spread is unchanged, with standard deviation 1.","key":"SFw9gWUevf","urlSource":"images/gen/m11-shift-hist.svg"}],"enumerator":"1","key":"b6ZfVfQwEZ"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"We observe that shifting the distribution over to the right 6 units also shifts the center over 6 units: in other words, the mean of (X + 6) should equal the (mean of X) + 6. However, the spread of the distribution is unchanged: the standard deviation of (X + 6) equals the standard deviation of X. Likewise, subtracting 7 shifts the mean to -7, and the standard deviation remains unchanged at 1.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"ESZeZnn0rd"}],"key":"Np5ifOp7fC"},{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Multiplying X by a Constant","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"SB4AUTtf5s"}],"identifier":"multiplying-x-by-a-constant","label":"Multiplying X by a Constant","html_id":"multiplying-x-by-a-constant","implicit":true,"key":"R86WfvwVW9"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"What would the mean and standard deviation be if we stretched the entire histogram by a factor of 4—in other words, what are the mean and standard deviation of 4X? And what if we shrank it by a fourth, to get (1/4)X?","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"uAHubAInSD"}],"key":"Sj0waUoaRU"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/textbook/build/m11-scale-hist-9759ca71048642253a5ed89ea78b2ad2.svg","alt":"Three probability histograms with the same shape but different widths. The original X spans values from negative 2 to 2 with standard deviation 1. The histogram for 4X spans negative 8 to 8, stretched to standard deviation 4. The histogram for X over 4 spans only negative 0.5 to 0.5, shrunk to standard deviation one quarter.","key":"ez50fTPZmP","urlSource":"images/gen/m11-scale-hist.svg"}],"enumerator":"2","key":"W3K4dDmUs1"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Multiplying X by 4 results in a mean that is 4 times the original mean. In this case, the mean transforms from 0 to ","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"jWv9DIdSsl"},{"type":"inlineMath","value":"4(0) = 0","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>4</mn><mo stretchy=\"false\">(</mo><mn>0</mn><mo stretchy=\"false\">)</mo><mo>=</mo><mn>0</mn></mrow><annotation encoding=\"application/x-tex\">4(0) = 0</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">4</span><span class=\"mopen\">(</span><span class=\"mord\">0</span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0</span></span></span></span>","key":"JOZHHF1dJV"},{"type":"text","value":". Multiplying X by 4 is tantamount to stretching the distribution by a factor of 4, and so the standard deviation will be 4 times the original standard deviation. The variance, or squared standard deviation, would be ","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"J2ZtTKhTOV"},{"type":"span","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"4","key":"MYql7fxebi"},{"type":"superscript","children":[{"type":"text","value":"2","key":"zqWrkFlw7L"}],"key":"mG8hjgCp3m"}],"key":"RRxik3spXd"},{"type":"text","value":" times the original variance: the variance of 4X is 16 times the variance of X.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"tQb6haRK1P"}],"key":"BOmXdtD7Yb"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Dividing X by 4 results in a mean that is 1/4 the original mean (still 0 here). Dividing X by 4 shrinks the distribution by a factor of 4, and so the standard deviation will be 1/4 of the original standard deviation, and the variance of (1/4)X is 1/16 times the variance of X.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"CGk5j1qDjr"}],"key":"mBi2Dwqihu"}],"key":"N6yZCohqKn"}],"key":"BRjalZtdKk"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Same Mean, Different Risk: Comparing Random Variables","url":"/pages/p140-m11-mean-and-variance-of-a-random-variable-5-","group":"Section 8: Random Variables"},"next":{"title":"Linear Transformations: The Rule for a + bX","url":"/pages/p142-m11-rules-for-means-and-variances-of-random-v","group":"Section 8: Random Variables"}}},"domain":"http://localhost:3000"}