umn":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"What is the probability that a randomly selected person will have earrings in both ears?","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"GkE41kLGnQ"}],"key":"GDHDrFmAvi"}],"key":"SCMYweBphG"},{"type":"listItem","spread":true,"position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"What is the probability that a randomly selected person will not be wearing any earrings in either ear?","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"gUDaErmTgA"}],"key":"C1q5znyUFc"}],"key":"rPApn1ABlb"}],"key":"WSmF1eK7lA"}],"class":"tip","key":"f4mf9NPuwC"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Comment","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"It0SM3qmnm"}],"key":"kURcv3Yg5z"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"We identified the first example as ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"PAIaeiiMDT"},{"type":"emphasis","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"theoretical","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"gRhAssEsO6"}],"key":"FujvBF14ss"},{"type":"text","value":" and the second as ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"seWunp98J5"},{"type":"emphasis","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"observational","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"vuofwwG7oc"}],"key":"fJsezlCVDR"},{"type":"text","value":". Let’s discuss the distinction. To answer probability questions about a theoretical situation, we only need the principles of probability. However, if we have an observational situation, the only way to answer probability questions is to use the relative frequency we obtain from a random sample.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"qhz3UdreWX"}],"key":"W8LG9va5I5"}],"class":"important","key":"bKZSU6hITx"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"Here is a different type of example:","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"OVwxqqobXp"}],"key":"O2heYuxPnm"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Example: Lightweight Boxer","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"JiykdIA7xK"}],"key":"TPmXZNcGu3"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"Assume we choose a lightweight male boxer at random and record his exact weight. According to the boxing rules, a lightweight male boxer must weigh between 130 and 135 pounds, so the sample space here is S = { all the numbers in the interval 130–135 }. (Note that we can’t list all the possible outcomes here.)","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"dCIw7y4eLc"}],"key":"gMr3UBs8gd"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"We’ll ","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"LGpKsPGU0L"},{"type":"emphasis","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"define X to be the weight of the boxer","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"tZ3SMPttYX"}],"key":"IFuNGxxuA7"},{"type":"text","value":" (again, as the definition suggests, X is a quantitative variable whose value is the result of our random experiment). Here X can take any value between 130 and 135. We can ask questions like:","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"wgl88MVqO8"}],"key":"OWNAnzgpvy"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":75,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"What is the probability that X will be more than 132? In other words, what is the probability that the boxer will weigh more than 132 pounds?","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"ALGHrOeQFE"}],"key":"XGkJ3CtDFJ"}],"key":"bz7hF326HO"},{"type":"listItem","spread":true,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"What is the probability that X will be between 131 and 133? In other words, what is the probability that the boxer weighs between 131 and 133 pounds?","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"JcmWfQsA0U"}],"key":"PkuwW9jGp6"}],"key":"K5y4Jf7bws"}],"key":"fmNZTHIdHN"}],"class":"tip","key":"dIE34USDYH"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"What is the difference between the random variables in these examples? Let’s see:","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"tnMW3R0Lqt"}],"key":"SkhGoTRNWi"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":81,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"They all arise from a random experiment (tossing a coin twice, choosing a person at random, choosing a lightweight boxer at random).","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"U05AZd9j1j"}],"key":"HV7BBJ4qfX"}],"key":"aRTyLRz1mP"},{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"They are all quantitative (number of tails, number of ears, weight).","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"fV9x0geLls"}],"key":"BB7g1qFpcZ"}],"key":"J43j8vWslZ"}],"key":"KtB3M2WCCf"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Where they differ is in the type of possible values they can take: In the first two examples, X has three distinct possible values: 0, 1, and 2. You can list them. In contrast, in the third example, X takes any value in the interval 130–135, and thus the possible values of X cover an infinite range of possibilities, and cannot be listed.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"woZiJhauNn"}],"key":"I4jaPu41Zd"},{"type":"paragraph","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"A random variable like the one in the first two examples, whose possible values are a list of distinct values, is called a ","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"hOJXNgUVLr"},{"type":"crossReference","label":"discrete random variable","identifier":"term-discrete random variable","children":[{"type":"text","value":"discrete random variable","key":"cO1aYISAW7"}],"kind":"definitionTerm","template":"{name}","resolved":true,"html_id":"term-discrete-random-variable","remote":true,"url":"/pages/glossary","dataUrl":"/pages.glossary.json","key":"pXLQdHobfv"},{"type":"text","value":". A random variable like the one in the third example, that can take any value in an interval, is called a ","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"eaL1kBRuSS"},{"type":"crossReference","label":"continuous random variable","identifier":"term-continuous random variable","children":[{"type":"text","value":"continuous random variable","key":"USJQD6xr3N"}],"kind":"definitionTerm","template":"{name}","resolved":true,"html_id":"term-continuous-random-variable","remote":true,"url":"/pages/glossary","dataUrl":"/pages.glossary.json","key":"MKQ3bs15kh"},{"type":"text","value":".","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"Bt4uyMl0RS"}],"key":"BluLNTP9Ua"},{"type":"paragraph","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"Just as the distinction between categorical and quantitative variables was important in Exploratory Data Analysis, the distinction between discrete and continuous random variables is important here, as each one gets a different treatment when it comes to calculating probabilities and other quantities of interest.","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"oeJLeBtUgL"}],"key":"xMrDz18EXu"}],"key":"JQyqQRVNKy"}],"key":"sNXaEqHmgo"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Wrap-Up: Conditional Probability and Independence","url":"/pages/m10-wrap-up-conditional-probability-and-independen","group":"Section 7: Conditional Probability and Independence"},"next":{"title":"Discrete or Continuous? Classifying Random Variables","url":"/pages/m11-random-variables-2-of-2","group":"Section 8: Random Variables"}}},"domain":"http://localhost:3000"}