":1}},"children":[{"type":"tableCell","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"[90–100]","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"mldKCEp7iB"}],"key":"xv0nkXby3D"},{"type":"tableCell","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"1","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"Ru1xJdQi56"}],"key":"dgNstNQFud"}],"key":"hCk2JBZVGh"}],"key":"hgq9pFxqox"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-ab552a073177c801fc08fc2e7e8860b3.mjs","model":{"question":"How many students scored below 60 on the exam?","choices":[{"correct":false,"text":"2","feedback":"Don't forget the one student in the [40–50) interval."},{"correct":true,"text":"3","feedback":"Correct! $1 + 2 = 3$ students scored in the [40–50) and [50–60) intervals."},{"correct":false,"text":"7","feedback":"Careful—[60–70) includes 60 itself, so its 4 students did not score below 60."}],"multi":false,"hint":"Which intervals contain only scores less than 60?","explanation":""},"key":"upHEhZmdhb"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-ab552a073177c801fc08fc2e7e8860b3.mjs","model":{"question":"What percentage of the 15 students scored between 60 and 80 (that is, in the intervals [60–70) and [70–80))?","choices":[{"correct":false,"text":"33%","feedback":"33% counts only the [70–80) interval."},{"correct":true,"text":"60%","feedback":"Correct! $(4 + 5)/15 = 9/15 = 0.60$, or 60%."},{"correct":false,"text":"27%","feedback":"27% counts only the [60–70) interval."}],"multi":false,"hint":"Add the counts in the two intervals, divide by 15, and convert to a percentage.","explanation":""},"key":"USb6JqdVlX"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Comments","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"uidbQkRiWm"}],"key":"Zha46jzMIm"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":98,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":98,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"text","value":"It is very important that each observation be counted only in one interval. For the most part, it is clear which interval an observation falls in. However, in our example, we needed to decide whether to include 60 in the interval 50–60, or the interval 60–70, and we chose to count it in the latter. In fact, this decision is captured by the way we wrote the intervals. If you scroll up and look at the table, you’ll see that we wrote the intervals in a peculiar way: [40–50), [50–60), [60–70), and so on. The square bracket means “including,” and the parenthesis means “not including.” For example, [50–60) is the interval from 50 to 60, including 50 and not including 60; [60–70) is the interval from 60 to 70, including 60, and not including 70. It does not matter how you decide to set up your intervals as long as you’re consistent.","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"asWfJmvMXD"}],"key":"Dpz8pbgoEO"}],"key":"W4vmHj8Ckj"},{"type":"listItem","spread":true,"position":{"start":{"line":100,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"When data are displayed in a histogram, some information is lost. Note that by looking at the histogram we ","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"iAi5o0wg12"},{"type":"emphasis","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"can","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"bH2sTdpZdm"}],"key":"JZCSeFIQ78"},{"type":"text","value":" answer: “How many students scored 70 or above?” ","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"ukC3lhTqr7"},{"type":"inlineMath","value":"(5 + 2 + 1 = 8)","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo stretchy=\"false\">(</mo><mn>5</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>1</mn><mo>=</mo><mn>8</mn><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">(5 + 2 + 1 = 8)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">(</span><span class=\"mord\">5</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">2</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">1</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">8</span><span class=\"mclose\">)</span></span></span></span>","key":"k6tmLVWB3p"},{"type":"text","value":" But we ","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"HmdxRkl5qR"},{"type":"emphasis","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"cannot","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"kFqQ96WDA9"}],"key":"uO52wXieiM"},{"type":"text","value":" answer: “What was the lowest score?” All we can say is that the lowest score is somewhere between 40 and 50, and therefore we can approximate that it is around 45.","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"UyYYAd7YWi"}],"key":"fqVFIVhJlh"}],"key":"JNy2n8YRQ8"},{"type":"listItem","spread":true,"position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"Obviously, we could have chosen to break the data into intervals differently (for example, 45–50, 50–55, 55–60). There is no single “correct” choice: wider bins give a smoother but coarser picture, while narrower bins show more detail but can look jagged. When you create histograms using statistical software or a calculator, try a few different bin widths and notice how the shape of the histogram changes.","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"FGhg2xkNgF"}],"key":"cIXvbGbdxC"}],"key":"USJ0epXIWV"}],"key":"JB4TTPWYcl"}],"class":"important","key":"ivAcRFF8Z1"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-ab552a073177c801fc08fc2e7e8860b3.mjs","model":{"question":"Using only the histogram of the 15 exam grades (not the raw data), which of the following questions can you answer exactly?","choices":[{"correct":false,"text":"What was the highest score?","feedback":"The exact highest score can't be recovered from the histogram—we only know it lies in the [90–100] interval."},{"correct":true,"text":"How many students scored 80 or above?","feedback":"Correct! Counts in intervals (and sums of counts) can be read exactly from a histogram: $2 + 1 = 3$ students scored 80 or above."},{"correct":false,"text":"What was the average score?","feedback":"The exact average requires the individual scores, which the histogram does not show."}],"multi":false,"hint":"A histogram tells you how many observations fall in each interval, but not the individual values.","explanation":""},"key":"yUmY8RMoBV"}],"key":"rzifwOo0PD"}],"key":"zbaXXxEqE7"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Graphs for a Quantitative Variable","url":"/pages/m04-graphs","group":"Section 3: Examining Distributions"},"next":{"title":"Describing a Distribution: Shape, Center, Spread, and Outliers","url":"/pages/m04-histogram-2-of-3","group":"Section 3: Examining Distributions"}}},"domain":"http://localhost:3000"}