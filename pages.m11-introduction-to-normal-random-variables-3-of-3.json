e":42,"column":1}},"key":"IzxWNVwxJo"}],"key":"wNvgo7axwh"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"(a)","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"gHXkmSrtsW"}],"key":"NtqTuDCHy5"},{"type":"text","value":" What is the standardized value for a male foot length of 8.5 inches? How does this foot length relate to the mean?","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"l0nP1zyhgu"}],"key":"ogfBS5c8gS"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"z = (8.5 − 11) / 1.5 = −1.67. This foot length is 1.67 standard deviations ","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"v4NdPOwdzt"},{"type":"emphasis","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"below","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"LiqfVwJo45"}],"key":"X5cofAzXRn"},{"type":"text","value":" the mean.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"D42dtFWkns"}],"key":"PStQ6L2sVP"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"(b)","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"oUEv2tUdN0"}],"key":"DZTkHHM1sg"},{"type":"text","value":" A man’s standardized foot length is +2.5. What is his actual foot length in inches? If z = +2.5, then his foot length is 2.5 standard deviations above the mean. Since the mean is 11, and each standard deviation is 1.5, we get that the man’s foot length is: 11 + 2.5(1.5) = 14.75 inches.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"J8bUzFXXWS"}],"key":"MqYa2HPbXl"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"z-scores also allow us to compare values of different normal random variables. Here is an example:","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"xn1SBSOPLh"}],"key":"jMASpc0yPB"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"(c)","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"cwUBBRv9R7"}],"key":"ssY9jmSp4X"},{"type":"text","value":" In general, women’s foot length is shorter than men’s. Assume that women’s foot length follows a normal distribution with a mean of 9.5 inches and standard deviation of 1.2. Ross’ foot length is 13.25 inches, and Candace’s foot length is only 11.6 inches. Which of the two has a longer foot relative to his or her gender group?","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"yq2Cnj06md"}],"key":"ic1zAgodm4"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"To answer this question, let’s find the z-score of each of these two normal values, bearing in mind that each of the values comes from a different normal distribution.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"ED73GCE67a"}],"key":"uG4yBUq5it"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"Ross: z-score = (13.25 − 11) / 1.5 = 1.5 (Ross’ foot length is 1.5 standard deviations above the mean foot length for men).","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"dYhE6IIs7g"}],"key":"SwdPpDMrAS"},{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Candace: z-score = (11.6 − 9.5) / 1.2 = 1.75 (Candace’s foot length is 1.75 standard deviations above the mean foot length for women).","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"tMoq3tSvxW"}],"key":"zDeu8buhDT"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Note that even though Ross’ foot is longer than Candace’s, Candace’s foot is longer relative to their respective genders.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"WI4Ayl7bEW"}],"key":"SLmzyiBIr3"}],"class":"tip","key":"d8u72KBSpO"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Tip","key":"QXtYcunwTM"}],"key":"hSTk9z9ZNU"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"Part (c) illustrates how z-scores become crucial when you want to ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"iWeq2V2UtG"},{"type":"emphasis","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"compare distributions","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"iHxC7G5uF8"}],"key":"zB8Hvj6Cnt"},{"type":"text","value":".","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"du5VdHDzXN"}],"key":"E66z9liGBk"}],"key":"N7dXCy5ISa"},{"type":"heading","depth":2,"position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"Check Your Understanding: Computing z-Scores","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"lqUNviyu5e"}],"identifier":"check-your-understanding-computing-z-scores","label":"Check Your Understanding: Computing z-Scores","html_id":"check-your-understanding-computing-z-scores","implicit":true,"key":"nxHkDFZ58x"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"Scores on the final exam in Professor Meyer’s statistics class follow a normal distribution, with a mean of 82 and a standard deviation of 5.","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"gDeziXNUdB"}],"key":"s9Ml0uncZa"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-faeec8a11af0994557177489ef8f052f.mjs","model":{"question":"What is the z-score of an exam score of 87?","choices":[{"correct":true,"text":"+1","feedback":"Correct! z = 5/5 = +1: the score is 1 standard deviation above the mean."},{"correct":false,"text":"−1","feedback":"−1 would be the z-score of 77, which is below the mean."},{"correct":false,"text":"+5","feedback":"5 is the raw distance from the mean; divide by the standard deviation."}],"multi":false,"hint":"z = (87 − 82)/5.","explanation":""},"key":"LQr20Gh6W9"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-faeec8a11af0994557177489ef8f052f.mjs","model":{"question":"What is the z-score of an exam score of 74.5?","choices":[{"correct":true,"text":"−1.5","feedback":"Correct! z = −7.5/5 = −1.5: the score is 1.5 standard deviations below the mean."},{"correct":false,"text":"+1.5","feedback":"+1.5 would be the z-score of 89.5, above the mean."},{"correct":false,"text":"−7.5","feedback":"−7.5 is the raw deviation; divide by 5 to standardize it."}],"multi":false,"hint":"z = (74.5 − 82)/5.","explanation":""},"key":"ypAQFA2v7V"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-faeec8a11af0994557177489ef8f052f.mjs","model":{"question":"A student's exam z-score is +2.2. What was the student's actual score?","choices":[{"correct":true,"text":"93","feedback":"Correct! 82 + 2.2(5) = 93."},{"correct":false,"text":"84.2","feedback":"84.2 adds the z-score directly instead of multiplying it by the standard deviation first."},{"correct":false,"text":"71","feedback":"71 corresponds to z = −2.2, below the mean."}],"multi":false,"hint":"x = μ + zσ = 82 + 2.2(5).","explanation":""},"key":"xB3t99AQba"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-faeec8a11af0994557177489ef8f052f.mjs","model":{"question":"On a different exam, scores were normal with mean 75 and standard deviation 10. Maria scored 88 on that exam, and Tom scored 90 on Professor Meyer's exam (mean 82, SD 5). Who did better relative to their own class?","choices":[{"correct":true,"text":"Tom—his z-score (1.6) is higher than Maria's (1.3)","feedback":"Correct! Tom's z = 1.6 exceeds Maria's z = 1.3, so Tom did better relative to his class, even though the raw comparison is closer."},{"correct":false,"text":"Maria—her z-score is higher","feedback":"Maria's z-score is (88−75)/10 = 1.3, which is lower than Tom's 1.6."},{"correct":false,"text":"They cannot be compared","feedback":"The exams have different means and spreads, so raw scores can't be compared directly—that's exactly what z-scores are for."}],"multi":false,"hint":"Compare z-scores: Maria (88−75)/10 vs. Tom (90−82)/5.","explanation":""},"key":"WWKus2uO4u"}],"key":"vwBvD2r3X0"}],"key":"VYo0UtIugR"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"The 68-95-99.7 Rule for Normal Variables","url":"/pages/m11-introduction-to-normal-random-variables2-of-3","group":"Section 8: Random Variables"},"next":{"title":"Reading the Standard Normal Table","url":"/pages/m11-standard-normal-table-1-of-3","group":"Section 8: Random Variables"}}},"domain":"http://localhost:3000"}