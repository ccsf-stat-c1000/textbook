nd":{"line":22,"column":1}},"key":"qPIWJYEwts"}],"key":"Oo74kztu51"}],"key":"ZM3cfRHcws"},{"type":"listItem","spread":true,"position":{"start":{"line":24,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"What is the probability that the student is male and has ear(s) pierced? Since a student is chosen at random from the group of 500 students, out of which 36 are male and have their ear(s) pierced, P(M and E) = 36/500 = 0.072.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"iMLstFp1Ll"}],"key":"FdIQMSFWAw"}],"key":"EDZKxPKduw"}],"key":"jolFBMJMl2"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Now something new:","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"QhezvDkN1O"}],"key":"Au1Rpycuyf"},{"type":"list","ordered":true,"start":4,"spread":false,"position":{"start":{"line":28,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":28,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"emphasis","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Given","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"MdKXp2JjYB"}],"key":"Fm6rmvxZ0L"},{"type":"text","value":" that the student that was chosen is male, what is the probability that he has one or both ears pierced?","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"XjwkvclGr9"}],"key":"CMCcIdfc0o"}],"key":"npyKgQPzVs"}],"key":"efsqD59QxO"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"At this point, new notation is required, to express the probability of a certain event given that another event holds. We will write “the probability of having one or both ears pierced (E), given that a student is male (M)” as ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"fOrkzhCD6M"},{"type":"emphasis","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"P(E | M).","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"QfPg6gaLBm"}],"key":"fs7G4LXLQe"}],"key":"RGYy4QpuJV"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"A word about this new notation: The event whose probability we seek (in this case E) is written first, the vertical line stands for the word “given” or “conditioned on,” and the event that is given (in this case M) is written after the “|” sign.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"cLwHhi0PYl"}],"key":"IbBiGCktM6"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"We call this probability the ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"Coq73kU2we"},{"type":"crossReference","label":"conditional probability","identifier":"term-conditional probability","children":[{"type":"text","value":"conditional probability","key":"S9Tpn9DMIr"}],"kind":"definitionTerm","template":"{name}","resolved":true,"html_id":"term-conditional-probability","remote":true,"url":"/pages/glossary","dataUrl":"/pages.glossary.json","key":"TWWrvwhl0a"},{"type":"text","value":" of having one or both ears pierced, given that a student is male: it assesses the probability of having pierced ears under the condition of being male. Now to solve for the probability, we observe that choosing from only the males in the school essentially alters the sample space S from all students in the school to all male students in the school. The total number of possible outcomes is no longer 500, but has changed to 180. Out of those 180 males, 36 have ear(s) pierced, and thus:","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"RTO3rUQmu6"}],"key":"uKhKCEF7aI"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"P(E | M) = 36/180 = 0.20.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"qCG7fVtPPz"}],"key":"KTDwCW6BD9"}],"class":"tip","key":"xczICf5qTE"},{"type":"heading","depth":2,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Check Your Understanding: Conditional Probability","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"z1MrK4ktO3"}],"identifier":"check-your-understanding-conditional-probability","label":"Check Your Understanding: Conditional Probability","html_id":"check-your-understanding-conditional-probability","implicit":true,"key":"CBlhHFaSHa"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-612a97c1bdda77747487ee7393cbf45b.mjs","model":{"question":"Using the same table, what is P(E | not M)—the probability that a randomly chosen female student has pierced ears?","choices":[{"correct":true,"text":"0.9","feedback":"Correct! Among the 320 females, 288 have pierced ears: P(E | not M) = 288/320 = 0.9."},{"correct":false,"text":"0.648","feedback":"0.648 is P(E), the overall proportion of pierced ears among all 500 students."},{"correct":false,"text":"0.576","feedback":"288/500 = 0.576 is P(female and pierced), not the conditional probability given female."}],"multi":false,"hint":"Restrict the sample space to the 320 female students.","explanation":""},"key":"ymo6V8i8Lu"},{"type":"anywidget","esm":"/textbook/build/quiz-widget-612a97c1bdda77747487ee7393cbf45b.mjs","model":{"question":"Compare P(E) = 0.648 with P(E | M) = 0.20. What does 